---
import { services } from '../content/site';
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="section-kicker">What you get</p>
      <h2 id="services-title">Design, hosting, <em>and support.</em></h2>
    </header>

    <div class="service-list">
      {services.map((service) => (
        <article data-reveal>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </article>
      ))}
    </div>

    <aside class="payments-note" data-reveal>
      <h3>Accept deposits and invoice payments online</h3>
      <a href="#contact">Ask Leon <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</section>
