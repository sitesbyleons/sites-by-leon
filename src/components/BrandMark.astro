---
interface Props {
  href?: string;
  large?: boolean;
}

const { href, large = false } = Astro.props;
const Tag = href ? 'a' : 'div';
const brandLogo = '';
---

<Tag
  class:list={['brand-mark', { 'brand-mark--large': large }]}
  href={href}
  aria-label={href ? 'Sites by Leon, home' : undefined}
>
  <span class="brand-mark__art" aria-hidden="true">
    <img src={`data:image/png;base64,${brandLogo}`} alt="" width="447" height="447" />
  </span>
  <span class="sr-only">Sites by Leon</span>
</Tag>

