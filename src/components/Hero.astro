---
import { concepts } from '../content/site';

const heroImages = [concepts[0].images[0], concepts[1].images[0], concepts[1].images[1]];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__shell">
    <div class="hero__copy" data-reveal>
      <p class="hero__eyebrow">Websites and hosting for photographers</p>
      <h1 id="hero-title"><span>Websites for</span>{' '}<span class="hero__subject">photographers.</span>{' '}<em>Hosting included.</em></h1>
      <p class="hero__lede">Portfolio pages, inquiries, payments, updates, and support.</p>
      <div class="hero__actions">
        <a class="button" href="#contact">Email Leon <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#work">View examples</a>
      </div>
    </div>

    <div class="hero-gallery" data-reveal aria-label="Wedding, portrait, and commercial photography concepts">
      {heroImages.map((image, index) => (
        <figure class={`hero-gallery__image hero-gallery__image--${index + 1}`} data-motion-depth="hero">
          <img
            src={image.src}
            alt={image.alt}
            width="1536"
            height="1024"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
          />
        </figure>
      ))}
    </div>
  </div>
</section>
