---
import BrandMark from './BrandMark.astro';
---

<section class="section founder" aria-labelledby="founder-title">
  <div class="container founder__grid">
    <div class="founder__mark" data-reveal>
      <BrandMark large />
    </div>
    <div class="founder__copy" data-reveal>
      <p class="section-kicker">Sites By Leon</p>
      <h2 id="founder-title">One person. <em>Start to finish.</em></h2>
      <p class="founder__lead">I design and host websites for photographers who want the web handled properly.</p>
      <p>You work directly with me for the design, launch, updates, and support.</p>
      <a class="text-link text-link--dark" href="#contact">Contact Leon</a>
    </div>
  </div>
</section>
