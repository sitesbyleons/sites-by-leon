---
import BrandMark from './BrandMark.astro';
---

<section class="section founder" aria-labelledby="founder-title">
  <div class="container founder__grid">
    <div class="founder__mark" data-reveal>
      <BrandMark large />
    </div>
    <div class="founder__copy" data-reveal>
      <p class="section-kicker">Sites By Leon</p>
      <h2 id="founder-title">Work directly <em>with Leon.</em></h2>
      <p class="founder__lead">Leon designs, builds, and hosts websites for photographers.</p>
      <p>Email Leon for design, launch, updates, and support.</p>
      <a class="text-link text-link--dark" href="#contact">Contact Leon</a>
    </div>
  </div>
</section>
