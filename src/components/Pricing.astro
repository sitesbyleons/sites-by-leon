---
import { plans } from '../content/site';
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="section-kicker">Monthly plans</p>
      <h2 id="pricing-title">Choose a <em>monthly plan.</em></h2>
    </header>

    <div class="pricing-grid" data-reveal>
      {plans.map((plan, index) => (
        <article class:list={['pricing-card', { 'pricing-card--featured': plan.featured }]} data-motion-depth="pricing">
          <header class="pricing-card__header">
            <span class="pricing-card__index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{plan.name}</h3>
            <p class="pricing-card__price"><sup>$</sup>{plan.monthlyPrice}<span>/mo</span></p>
          </header>
          <p class="pricing-card__description">{plan.description}</p>
          <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
          <a class="pricing-card__action" href="#contact" aria-label={`Contact about ${plan.name}`}>Choose {plan.name} <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>

  </div>
</section>
