---
import { contactEmail, instagramUrl } from '../content/site';
import BrandMark from './BrandMark.astro';
---

<footer class="site-footer">
  <div class="container site-footer__top">
    <BrandMark href="#top" />
    <a class="site-footer__email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </div>
  <div class="container site-footer__bottom">
    <nav aria-label="Footer navigation"><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="#contact">Contact</a></nav>
    <nav aria-label="Social and legal navigation"><a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a></nav>
    <p>© {new Date().getFullYear()} Sites By Leon</p>
  </div>
</footer>
