---
import { navigation } from '../content/site';
import BrandMark from './BrandMark.astro';

interface Props {
  home?: boolean;
}

const { home = true } = Astro.props;
const resolveHref = (href: string) => (home ? href : `/${href}`);
---

<header class="site-header" data-site-header>
  <div class="site-header__shell">
    <BrandMark href={home ? '#top' : '/'} />

    <nav class="site-nav" aria-label="Primary navigation">
      <ul class="site-nav__links">
        {navigation.map((item) => (
          <li><a href={resolveHref(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <button
        class="motion-toggle"
        type="button"
        data-motion-toggle
        aria-label="Enable motion"
        aria-pressed="false"
        hidden
      >
        <span class="motion-toggle__dot" aria-hidden="true"></span>
        <span data-motion-toggle-label>Motion off</span>
      </button>
      <a class="button button--small" href={resolveHref('#contact')}>Contact</a>
    </nav>
  </div>
</header>
