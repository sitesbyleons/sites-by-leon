---
import { navigation } from '../content/site';
import BrandMark from './BrandMark.astro';

interface Props {
  home?: boolean;
}

const { home = true } = Astro.props;
const resolveHref = (href: string) => (home ? href : `/${href}`);
---

<header class="site-header" data-site-header>
  <div class="site-header__shell">
    <BrandMark href={home ? '#top' : '/'} />

    <nav class="site-nav" aria-label="Primary navigation" data-site-nav>
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        <span class="site-nav__toggle-label">Menu</span>
      </button>
      <ul class="site-nav__links" id="primary-nav">
        {navigation.map((item) => (
          <li><a href={resolveHref(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <a class="button button--small" href={resolveHref('#contact')}>Contact</a>
    </nav>
  </div>
</header>
