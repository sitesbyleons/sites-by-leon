---
import { contactEmail } from '../content/site';
---

<section class="section contact contact--simple" id="contact" aria-labelledby="contact-title">
  <div class="container contact-simple" data-reveal>
    <p class="section-kicker">Contact</p>
    <h2 id="contact-title">Tell Leon about your website.</h2>
    <a class="button button--ink" href={`mailto:${contactEmail}`}>
      Email Leon <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
