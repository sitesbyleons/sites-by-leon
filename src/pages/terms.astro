---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactEmail } from '../content/site';
---

<BaseLayout title="Terms — sites.by.leon" description="Website-use terms and service-information notice for sites.by.leon.">
  <SiteHeader home={false} />
  <main class="legal" id="main">
    <div class="container legal__inner">
      <p class="section-kicker">Terms</p>
      <h1>Website information and service terms.</h1>
      <p class="legal__updated">Last updated July 10, 2026</p>

      <section>
        <h2>Website information</h2>
        <p>This site introduces services offered by sites.by.leon. Portfolio examples marked “Concept Project” are original demonstrations of design direction and are not presented as commissioned client work.</p>
      </section>
      <section>
        <h2>Packages and scope</h2>
        <p>Displayed monthly packages are starting service options. The exact pages, content, support expectations, launch timing, and included updates are confirmed in writing before paid work begins.</p>
      </section>
      <section>
        <h2>Subscriptions and cancellation</h2>
        <p>When subscriptions become available, the agreed service terms will describe billing dates, cancellation, site handoff or export options, and what happens to hosting after cancellation. No payment is collected through this Phase 1 marketing site.</p>
      </section>
      <section>
        <h2>Accuracy and availability</h2>
        <p>Reasonable care is taken to keep this website accurate and available, but uninterrupted access is not guaranteed. Optional client-payment functionality is not active until separately agreed and tested.</p>
      </section>
      <section>
        <h2>Contact</h2>
        <p>Questions can be sent to <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
      </section>
      <a class="text-link" href="/">Return home</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
