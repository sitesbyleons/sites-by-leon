---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactEmail } from '../content/site';
---

<BaseLayout title="Terms - Sites By Leon" description="Terms for the Sites By Leon website and services.">
  <SiteHeader home={false} />
  <main class="legal" id="main">
    <div class="container legal__inner">
      <p class="section-kicker">Terms</p>
      <h1>Website and service terms.</h1>
      <p class="legal__updated">Last updated July 10, 2026</p>

      <section>
        <h2>Website information</h2>
        <p>This site describes services offered by Sites By Leon. Website examples marked “Concept Project” are demonstrations and are not commissioned client work.</p>
      </section>
      <section>
        <h2>Packages and scope</h2>
        <p>The monthly packages shown are starting options. Pages, content, support, launch timing, and included updates are confirmed in writing before paid work begins.</p>
      </section>
      <section>
        <h2>Subscriptions and cancellation</h2>
        <p>Monthly plans are billed through Stripe. The selected plan, billing date, cancellation terms, included updates, and hosting terms are shown or confirmed in writing before billing begins.</p>
      </section>
      <section>
        <h2>Accuracy and availability</h2>
        <p>Sites By Leon works to keep this website accurate and available, but cannot guarantee uninterrupted access. Client payment features are enabled only after setup and testing.</p>
      </section>
      <section>
        <h2>Contact</h2>
        <p>Questions can be sent to <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
      </section>
      <a class="text-link" href="/">Return home</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
