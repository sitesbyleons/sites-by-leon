---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactEmail } from '../content/site';
---

<BaseLayout title="Privacy — sites.by.leon" description="How sites.by.leon handles website inquiries and contact information.">
  <SiteHeader home={false} />
  <main class="legal" id="main">
    <div class="container legal__inner">
      <p class="section-kicker">Privacy</p>
      <h1>A short, plain-language privacy notice.</h1>
      <p class="legal__updated">Last updated July 10, 2026</p>

      <section>
        <h2>What is collected</h2>
        <p>If you contact sites.by.leon, the information you choose to send—such as your name, email, photography focus, and project message—is used to reply to your inquiry and discuss possible services.</p>
      </section>
      <section>
        <h2>How it is handled</h2>
        <p>Inquiry information is not sold and is not added to a marketing list. It may be stored with service providers used to operate the website and communication workflow. Access is limited to what is needed to respond and run the business.</p>
      </section>
      <section>
        <h2>Website operations</h2>
        <p>Basic technical logs may be processed by the website host for security and reliability. Payment details, when payment features are introduced, will be handled by the payment provider rather than stored by sites.by.leon.</p>
      </section>
      <section>
        <h2>Your questions</h2>
        <p>To ask about, correct, or request deletion of inquiry information, email <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
      </section>
      <a class="text-link" href="/">Return home</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
