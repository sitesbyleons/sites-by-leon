---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ConceptShowcase from '../components/ConceptShowcase.astro';
import Pricing from '../components/Pricing.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Sites By Leon — Website design and hosting"
  description="Affordable websites and hosting built for photographers, with portfolios, inquiries, payments, and ongoing support handled."
  canonicalUrl="https://test.leonsites.org/"
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <ConceptShowcase />
    <Pricing />
    <Services />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import '../scripts/site';
</script>
