---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ConceptShowcase from '../components/ConceptShowcase.astro';
import Pricing from '../components/Pricing.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Sites By Leon - Websites and hosting for photographers"
  description="Websites and hosting for photographers, with portfolio pages, inquiries, payments, updates, and direct support."
  canonicalUrl="https://leonsites.org/"
>
  <SiteHeader />
  <main id="main">
    <Hero />
    <ConceptShowcase />
    <Pricing />
    <Services />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import '../scripts/site';
</script>
