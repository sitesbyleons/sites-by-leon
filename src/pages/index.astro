---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComingSoon from '../components/ComingSoon.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ConceptShowcase from '../components/ConceptShowcase.astro';
import Pricing from '../components/Pricing.astro';
import Services from '../components/Services.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  hostSwitch
  title="Sites By Leon — Coming soon"
  description="Cinematic websites and managed hosting for photographers."
>
  <div class="host-coming">
    <ComingSoon />
  </div>

  <div class="host-preview">
    <SiteHeader />
    <main id="preview-main">
      <Hero />
      <ConceptShowcase />
      <Pricing />
      <Services />
      <Contact />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<script>
  import '../scripts/site';
</script>
