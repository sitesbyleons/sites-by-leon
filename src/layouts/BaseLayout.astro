---
import '@fontsource/allura/400.css';
import '@fontsource-variable/anybody/index.css';
import '@fontsource-variable/manrope/index.css';
import '@fontsource-variable/newsreader/index.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string | URL;
}

const {
  title = 'Sites By Leon',
  description = 'Websites and hosting for photographers, with monthly plans from $25 to $35.',
  canonicalUrl,
} = Astro.props;

const canonical = canonicalUrl
  ? new URL(canonicalUrl)
  : new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090a0c" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="sites.by.leon" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/sites-by-leon-mark.png" />
    <title>{title}</title>
  </head>
  <body id="top">
    <script>document.documentElement.classList.remove('no-js'); document.documentElement.classList.add('js');</script>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
