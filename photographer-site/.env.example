PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=replace_with_clerk_test_secret
DATABASE_URL=postgresql://leon_app:replace_me@database:5432/leon_platform
DATABASE_POOL_MAX=4
UPLOAD_ROOT=/data/uploads
MEDIA_STORAGE_BACKEND=local
# Private S3-compatible storage. Required only when MEDIA_STORAGE_BACKEND=s3.
# S3_ENDPOINT=https://s3.example-region.provider.example
# S3_REGION=example-region
# S3_BUCKET=leonsites-media
# S3_ACCESS_KEY_ID=replace_with_scoped_access_key
# S3_SECRET_ACCESS_KEY=replace_with_scoped_secret
# S3_FORCE_PATH_STYLE=true
# S3_KEY_PREFIX=media
WORKSPACE_UPLOAD_QUOTA_BYTES=4294967296
PUBLIC_MEDIA_URL=https://api.leonsites.org
SITE_CONTENT_MODE=managed
# Optional local/test fallbacks. Production tenant identity comes from the request hostname.
SITE_WORKSPACE_SLUG=northline
SITE_KEY=northline-demo
CONTACT_HASH_SALT=replace_with_a_random_secret
STRIPE_CONNECT_SECRET_KEY=sk_test_replace_me
STRIPE_CONNECT_DEFAULT_COUNTRY=us
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_V2_WEBHOOK_SECRET=whsec_replace_me
