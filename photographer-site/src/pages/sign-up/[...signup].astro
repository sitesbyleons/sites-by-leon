---
import ClerkUI from '../../components/ClerkUI.astro';
import { isIshotyouuSite } from '../../lib/ishotyouu';
import { normalizeStudioReturnPath } from '../../lib/studio-auth';
const dashboardUrl = normalizeStudioReturnPath(Astro.url.searchParams.get('redirect_url'));
if (isIshotyouuSite(Astro.locals.siteContext)) {
  return Astro.redirect(`/sign-in?redirect_url=${encodeURIComponent(dashboardUrl)}`);
}
const signInUrl = `/sign-in?redirect_url=${encodeURIComponent(dashboardUrl)}`;
---

<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Studio sign up</title></head>
<body style="margin:0;min-height:100dvh;display:grid;place-items:center;background:#f5f5f1;font-family:system-ui,sans-serif"><main><ClerkUI kind="sign-up" options={{ forceRedirectUrl: dashboardUrl, signInUrl }} /></main></body></html>
