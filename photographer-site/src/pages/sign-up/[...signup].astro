---
import ClerkUI from '../../components/ClerkUI.astro';
import { normalizeStudioReturnPath } from '../../lib/studio-auth';
const dashboardUrl = normalizeStudioReturnPath(Astro.url.searchParams.get('redirect_url'));
const signInUrl = `/sign-in?redirect_url=${encodeURIComponent(dashboardUrl)}`;
---

<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>Create studio account</title><link rel="stylesheet" href="/admin-assets/leon-studio-auth-v2.css" /></head>
<body class="studio-auth-page"><main><ClerkUI kind="sign-up" options={{ forceRedirectUrl: dashboardUrl, signInUrl }} /></main></body></html>
