---
import GalleryGrid from '../../components/GalleryGrid.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { demoRepository } from '../../lib/content/repository';

const galleries = await demoRepository.listGalleries();
---

<SiteLayout
  title="Work"
  description="Portrait stories of artists, makers, and independent people photographed by Northline Portrait Studio."
  image={galleries[0]?.cover.src}
  canonicalPath="/work"
>
  <header class="work-intro page-gutter">
    <p class="eyebrow" data-entrance>Selected work</p>
    <div class="work-intro-copy">
      <h1 id="work-title" data-entrance>Portrait stories, quietly observed.</h1>
      <p data-entrance>
        Artists, makers, and independent spirits photographed in the rooms and streets that shape their work.
      </p>
    </div>
  </header>

  <section class="work-archive page-gutter" aria-label="Portrait galleries">
    <GalleryGrid galleries={galleries} />
  </section>
</SiteLayout>
