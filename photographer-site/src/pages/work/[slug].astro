---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { imagePresentationStyle } from '../../lib/content/presentation';
import { siteRepository } from '../../lib/content/repository';
import { isIshotyouuSite } from '../../lib/ishotyouu';

const ishotyouu = isIshotyouuSite(Astro.locals.siteContext);
const slug = Astro.params.slug ?? '';
const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const gallery = portfolio.galleries.find((item) => item.slug === slug) ?? null;

if (!gallery) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const placements = gallery?.images.map((image, index) => ({ image, index }));
---

<SiteLayout
  title={gallery?.title ?? 'Gallery not found'}
  description={gallery?.description ?? `The requested ${portfolio.studioName} gallery could not be found.`}
  image={gallery?.cover.src}
  canonicalPath={`/work/${slug}`}
>
  {ishotyouu && gallery ? (
    <article class="page-shell" aria-labelledby="gallery-title">
      <header class="page-intro">
        <p class="section-kicker">{gallery.category || 'Gallery'}</p>
        <h1 id="gallery-title">{gallery.title}</h1>
        <p class="hint">{gallery.description || `${gallery.images.length} photographs.`}</p>
      </header>
      <div class="work-wall">
        {gallery.images.map((image) => (
          <div class="work-item">
            <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <nav class="gallery-return" aria-label="Gallery navigation">
        <a class="text-link" href="/work">All work</a>
      </nav>
    </article>
  ) : ishotyouu ? (
    <section class="page-shell" aria-labelledby="not-found-title">
      <p class="section-kicker">404</p>
      <h1 id="not-found-title">This gallery was not found.</h1>
      <p class="hint"><a class="text-link" href="/work">Return to all work</a></p>
    </section>
  ) : (
  <>
  {
    gallery ? (
      <article class="gallery-page">
        <header class="gallery-intro page-gutter">
          <p class="meta" data-entrance>{gallery.category}</p>
          <h1 data-entrance>{gallery.title}</h1>
          <div class="gallery-intro-notes" data-entrance>
            <p>{gallery.description}</p>
            <p>{gallery.images.length} photographs</p>
          </div>
        </header>

        <ol
          class:list={['gallery-sequence', 'page-gutter', `gallery-sequence--${gallery.layoutMode}`]}
          data-columns={gallery.gridColumns}
          data-gallery-layout={gallery.layoutMode}
        >
          {placements?.map(({ image, index }) => (
            <li class:list={['gallery-frame', { 'gallery-frame--lead': index === 0 }]} data-entrance>
              <figure data-image-drift={index % 2 === 0 ? 'slow' : 'fast'} style={imagePresentationStyle(image)}>
                <div class="gallery-drift-layer" data-image-drift-layer>
                  <img
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </div>
              </figure>
            </li>
          ))}
        </ol>

        <nav class="gallery-return page-gutter" aria-label="Gallery navigation">
          <a class="text-link" href="/work">All work</a>
        </nav>
      </article>
    ) : (
      <section class="not-found page-gutter" aria-labelledby="not-found-title">
        <p class="eyebrow">404 / Not found</p>
        <h1 id="not-found-title">This gallery was not found.</h1>
        <a class="text-link" href="/work">Return to all work</a>
      </section>
    )
  }
  </>
  )}
</SiteLayout>
