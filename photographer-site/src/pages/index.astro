---
import ContactSheet from '../components/ContactSheet.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { demoRepository } from '../lib/content/repository';

const portfolio = await demoRepository.getPortfolio();
const featuredGalleries = portfolio.home.featuredGallerySlugs
  .map((slug) => portfolio.galleries.find((gallery) => gallery.slug === slug))
  .filter((gallery) => gallery !== undefined);
const latestPost = [...portfolio.posts].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))[0];
const featuredPackage = portfolio.packages[0];
---

<SiteLayout
  title={portfolio.studioName}
  description={portfolio.home.introduction}
  image={featuredGalleries[1]?.cover.src}
  canonicalPath="/"
>
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-media" aria-hidden="true">
      <img
        src={featuredGalleries[1]?.cover.src}
        alt=""
        width={featuredGalleries[1]?.cover.width}
        height={featuredGalleries[1]?.cover.height}
        fetchpriority="high"
      />
    </div>
    <div class="hero-copy page-gutter">
      <div>
        <p class="eyebrow" data-entrance>{portfolio.home.eyebrow}</p>
        <h1 id="home-title" data-entrance>Portraits with a pulse.</h1>
      </div>
      <div class="hero-aside" data-entrance>
        <p>Cinematic portraiture for artists, founders, and families.</p>
        <a class="text-link" href="/work">View the work</a>
      </div>
    </div>
  </section>

  <ContactSheet galleries={featuredGalleries} />

  <section class="studio-position page-gutter" aria-labelledby="position-title">
    <p class="eyebrow">Approach</p>
    <div class="studio-position-copy">
      <h2 id="position-title">Patient direction. Honest presence.</h2>
      <p>Natural light, room to settle, and nothing overperformed.</p>
    </div>
  </section>

  <section class="featured-work page-gutter" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recent work</p>
        <h2 id="featured-title">Galleries</h2>
      </div>
      <a class="text-link" href="/work">All work</a>
    </div>
    <ol class="gallery-list">
      {
        featuredGalleries.map((gallery) => (
          <li class="gallery-entry">
            <a href={`/work/${gallery.slug}`}>
              <img
                src={gallery.cover.src}
                alt={gallery.cover.alt}
                width={gallery.cover.width}
                height={gallery.cover.height}
                loading="lazy"
                decoding="async"
              />
              <h3>{gallery.title}</h3>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {
    latestPost && (
      <section class="journal-feature" aria-labelledby="journal-feature-title">
        <div class="journal-feature-media">
          <img
            src={latestPost.cover.src}
            alt={latestPost.cover.alt}
            width={latestPost.cover.width}
            height={latestPost.cover.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="journal-feature-copy">
          <div>
            <p class="eyebrow">From the journal</p>
            <h2 id="journal-feature-title">{latestPost.title}</h2>
            <p>{latestPost.excerpt}</p>
          </div>
          <a class="text-link" href={`/journal/${latestPost.slug}`}>Read the story</a>
        </div>
      </section>
    )
  }

  {
    featuredPackage && (
      <section class="package-teaser page-gutter" aria-labelledby="package-title">
        <div>
          <p class="eyebrow">Session notes</p>
          <h2 id="package-title">Portrait sessions, thoughtfully shaped.</h2>
          <a class="text-link" href="/packages">Explore packages</a>
        </div>
        <div class="package-detail">
          <p class="package-price">{featuredPackage.startingPrice}</p>
          <h3>{featuredPackage.name}</h3>
        </div>
      </section>
    )
  }

  <section class="contact-close" aria-labelledby="contact-title">
    <div class="contact-close-inner page-gutter">
      <h2 id="contact-title">Let's make a portrait.</h2>
      <div class="contact-close-copy">
        <a class="text-link" href="/contact">{portfolio.home.contactLabel}</a>
      </div>
    </div>
  </section>
</SiteLayout>
