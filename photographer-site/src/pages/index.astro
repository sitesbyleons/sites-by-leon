---
import ContactSheet from '../components/ContactSheet.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { ISHOTYOUU_FALLBACK_HERO } from '../lib/content/ishotyouu-fallback';
import { selectHomeHeroImages } from '../lib/content/home';
import { loadSiteTheme, siteRepository } from '../lib/content/repository';
import { ISHOTYOUU_INSTAGRAM_HANDLE, ISHOTYOUU_INSTAGRAM_URL, isIshotyouuSite } from '../lib/ishotyouu';

const ishotyouu = isIshotyouuSite(Astro.locals.siteContext);
const [portfolio, theme] = await Promise.all([
  siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId),
  loadSiteTheme(Astro.locals.siteContext.workspaceId),
]);
const ishotyouuHero = portfolio.galleries[0]?.cover.src
  ? { src: portfolio.galleries[0].cover.src, alt: portfolio.galleries[0].cover.alt }
  : ISHOTYOUU_FALLBACK_HERO;
const featuredGalleries = portfolio.home.featuredGallerySlugs
  .map((slug) => portfolio.galleries.find((gallery) => gallery.slug === slug))
  .filter((gallery) => gallery !== undefined);
const { leadLandscape, leadPortrait, imageCount: heroImageCount } = selectHomeHeroImages(featuredGalleries);
const serviceSummary = new Intl.ListFormat('en-US', { style: 'long', type: 'conjunction' })
  .format(portfolio.packages.map((service) => service.name));
---

<SiteLayout
  title={portfolio.studioName}
  description={portfolio.home.introduction || `Photography by ${portfolio.studioName}.`}
  image={ishotyouu ? ishotyouuHero.src : leadLandscape?.src}
  canonicalPath="/"
>
  {ishotyouu ? (
    <section class="hero" aria-labelledby="hero-title">
      <figure class="hero-frame">
        <img src={ishotyouuHero.src} alt={ishotyouuHero.alt} fetchpriority="high" decoding="async" />
      </figure>
      <div class="hero-veil"></div>
      <div class="hero-copy" data-enter>
        <h1 id="hero-title">{portfolio.home.headline || portfolio.studioName}</h1>
        <p class="handle">
          <a href={ISHOTYOUU_INSTAGRAM_URL} rel="noreferrer">{ISHOTYOUU_INSTAGRAM_HANDLE}</a>
        </p>
        <div class="hero-actions">
          <a class="hero-cta" href="/work">Work</a>
          <a class="hero-cta" href="/inquire">Inquire</a>
        </div>
      </div>
    </section>
  ) : (
  <>
  <section class="editorial-hero page-gutter" aria-labelledby="home-title" data-editorial-hero>
    <div class="editorial-hero-copy" data-entrance>
      <h1 id="home-title">{portfolio.home.headline}</h1>
      <p>{portfolio.home.introduction}</p>
    </div>

    <div class="editorial-hero-images" data-image-count={heroImageCount}>
      {
        leadLandscape && (
          <figure class="editorial-hero-image editorial-hero-image--landscape" data-image-drift="slow">
            <img
              src={leadLandscape.src}
              alt={leadLandscape.alt}
              width={leadLandscape.width}
              height={leadLandscape.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </figure>
        )
      }
      {
        leadPortrait && (
          <figure class="editorial-hero-image editorial-hero-image--portrait" data-image-drift="fast">
            <img
              src={leadPortrait.src}
              alt={leadPortrait.alt}
              width={leadPortrait.width}
              height={leadPortrait.height}
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </section>

  <ContactSheet galleries={featuredGalleries} tone={theme.fontPreset} />

  {
    portfolio.packages.length > 0 && (
      <section class="service-preview page-gutter" aria-labelledby="service-preview-title" data-entrance>
        <div>
          <h2 id="service-preview-title">Photography services</h2>
          <p>{serviceSummary}.</p>
        </div>
        <a class="text-link" href="/packages">Services</a>
      </section>
    )
  }

  <section class="home-contact page-gutter" aria-labelledby="home-contact-title" data-entrance>
    <h2 id="home-contact-title">Book coverage.</h2>
    {
      portfolio.email
        ? <a href={`mailto:${portfolio.email}`}>{portfolio.email}</a>
        : <a href="/contact">Contact</a>
    }
  </section>
  </>
  )}
</SiteLayout>
