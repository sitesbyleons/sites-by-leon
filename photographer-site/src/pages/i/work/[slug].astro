---
import IshotyouuLayout from '../../../layouts/IshotyouuLayout.astro';
import { siteRepository } from '../../../lib/content/repository';

const slug = Astro.params.slug ?? '';
const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const gallery = portfolio.galleries.find((item) => item.slug === slug) ?? null;
if (!gallery) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}
const { canonicalOrigin } = Astro.locals.siteContext;
---

<IshotyouuLayout
  title={gallery?.title ?? 'Gallery not found'}
  description={gallery?.description ?? `The requested ${portfolio.studioName} gallery could not be found.`}
  image={gallery?.cover.src}
  canonicalPath={`/work/${slug}`}
  studioName={portfolio.studioName}
  canonicalOrigin={canonicalOrigin}
>
  {gallery ? (
    <article class="page-shell" aria-labelledby="gallery-title">
      <header class="page-intro">
        <p class="section-kicker">{gallery.category || 'Gallery'}</p>
        <h1 id="gallery-title">{gallery.title}</h1>
        <p class="hint">{gallery.description || `${gallery.images.length} photographs.`}</p>
      </header>
      <div class="work-wall">
        {gallery.images.map((image) => (
          <div class="work-item">
            <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
      <nav class="gallery-return" aria-label="Gallery navigation">
        <a class="text-link" href="/work">All work</a>
      </nav>
    </article>
  ) : (
    <section class="page-shell" aria-labelledby="not-found-title">
      <p class="section-kicker">404</p>
      <h1 id="not-found-title">This gallery was not found.</h1>
      <p class="hint"><a class="text-link" href="/work">Return to all work</a></p>
    </section>
  )}
</IshotyouuLayout>
