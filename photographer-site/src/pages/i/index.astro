---
import IshotyouuLayout from '../../layouts/IshotyouuLayout.astro';
import { ISHOTYOUU_FALLBACK_HERO } from '../../lib/content/ishotyouu-fallback';
import { siteRepository } from '../../lib/content/repository';
import { ISHOTYOUU_INSTAGRAM_HANDLE, ISHOTYOUU_INSTAGRAM_URL } from '../../lib/ishotyouu';

const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const hero = ISHOTYOUU_FALLBACK_HERO;
const { canonicalOrigin } = Astro.locals.siteContext;
---

<IshotyouuLayout
  title={portfolio.studioName}
  description={portfolio.home.introduction || `Photography by ${portfolio.studioName}.`}
  image={hero.src}
  canonicalPath="/"
  studioName={portfolio.studioName}
  canonicalOrigin={canonicalOrigin}
>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-frame">
      <img src={hero.src} alt={hero.alt} fetchpriority="high" decoding="async" />
    </figure>
    <div class="hero-veil"></div>
    <div class="hero-copy" data-enter>
      <h1 id="hero-title">{portfolio.home.headline || portfolio.studioName}</h1>
      {portfolio.home.introduction && <p class="hero-lede">{portfolio.home.introduction}</p>}
      <p class="handle">
        <a href={ISHOTYOUU_INSTAGRAM_URL} rel="noreferrer">{ISHOTYOUU_INSTAGRAM_HANDLE}</a>
      </p>
      <div class="hero-actions">
        <a class="hero-cta" href="/work">Work</a>
        <a class="hero-cta" href="/inquire">Inquire</a>
      </div>
    </div>
  </section>
</IshotyouuLayout>
