---
import StudioAdminLayout from '../../layouts/StudioAdminLayout.astro';
import StudioMediaField from '../../components/StudioMediaField.astro';
import { decideStudioAdminAccess, loadStudioSession } from '../../lib/studio';
const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const auth = isPreview ? null : Astro.locals.auth();
const session = await loadStudioSession({ isPreview, userId: isPreview ? 'preview' : (auth?.userId ?? null), workspaceId: Astro.locals.siteContext.workspaceId, getToken: async () => auth ? (await auth.getToken()) ?? null : null });
const access = decideStudioAdminAccess(session, '/admin/galleries');
if (access.kind !== 'admin') return Astro.redirect(access.location);
const data = session.data!;
---

<StudioAdminLayout title="Galleries" active="galleries" studioName={data.workspace?.name ?? 'Studio'} isPreview={isPreview} error={data.error} workspaceId={data.workspace?.id} media={data.uploads}>
  <header class="studio-section-heading"><div><small>Portfolio</small><h2>Your galleries</h2></div><p>Edit, move, or remove each gallery.</p></header>
  <section class="studio-stack">
    {data.galleries.length ? data.galleries.map((gallery) => (
      <article class="studio-item">
        <img class="studio-item-thumb" src={gallery.cover_image_url} alt="" />
        <div class="studio-item-copy"><strong>{gallery.title}</strong><small>{gallery.category} · {data.images.filter((image) => image.gallery_id === gallery.id).length} images · {gallery.status}</small></div>
        <div class="studio-item-actions">
          <button type="button" class="studio-button-quiet" data-studio-action="up" data-resource="galleries" data-id={gallery.id} aria-label="Move gallery up">↑</button>
          <button type="button" class="studio-button-quiet" data-studio-action="down" data-resource="galleries" data-id={gallery.id} aria-label="Move gallery down">↓</button>
          <details class="studio-editor"><summary>Edit</summary>
            <form class="studio-form studio-editor-form" data-studio-form data-resource="galleries" data-upload-kind="cover">
              <input type="hidden" name="id" value={gallery.id} />
              <label><span>Title</span><input name="title" value={gallery.title} required /></label><label><span>URL</span><input name="slug" value={gallery.slug} required /></label>
              <label><span>Category</span><input name="category" value={gallery.category} required /></label><label><span>Status</span><select name="status"><option value="draft" selected={gallery.status === 'draft'}>Draft</option><option value="published" selected={gallery.status === 'published'}>Published</option></select></label>
              <label class="wide"><span>Description</span><textarea name="description">{gallery.description}</textarea></label>
              <StudioMediaField kind="cover" resource="galleries" label="Cover image" url={gallery.cover_image_url} path={gallery.cover_storage_path} currentId={gallery.id} />
              <div class="wide"><button type="submit">Save gallery</button></div><p class="studio-form-status wide" data-form-status></p>
            </form>
          </details>
          <button type="button" class="studio-button-danger" data-studio-action="delete" data-resource="galleries" data-id={gallery.id}>Delete</button>
        </div>
      </article>
    )) : <p class="studio-empty">No galleries yet.</p>}
  </section>

  <div class="studio-split">
    <section><header class="studio-section-heading"><div><small>New gallery</small><h2>Add a gallery</h2></div></header><div class="studio-panel">
      <form class="studio-form" data-studio-form data-resource="galleries" data-upload-kind="cover">
        <label><span>Title</span><input name="title" required /></label><label><span>URL</span><input name="slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required /></label>
        <label><span>Category</span><input name="category" required /></label><label><span>Status</span><select name="status"><option value="draft">Draft</option><option value="published">Published</option></select></label>
        <label class="wide"><span>Description</span><textarea name="description" maxlength="500"></textarea></label>
        <StudioMediaField kind="cover" resource="galleries" label="Cover image" />
        <div class="wide"><button type="submit">Create gallery</button></div><p class="studio-form-status wide" data-form-status></p>
      </form>
    </div></section>
    <section><header class="studio-section-heading"><div><small>New photograph</small><h2>Add an image</h2></div></header><div class="studio-panel">
      <form class="studio-form" data-studio-form data-resource="images" data-upload-kind="image">
        <label class="wide"><span>Gallery</span><select name="gallery_id" required><option value="">Choose gallery</option>{data.galleries.map((gallery) => <option value={gallery.id}>{gallery.title}</option>)}</select></label>
        <StudioMediaField kind="image" resource="images" label="Photograph" />
        <label class="wide"><span>Image description</span><input name="alt_text" required maxlength="300" /></label>
        <div class="wide"><button type="submit">Add image</button></div><p class="studio-form-status wide" data-form-status></p>
      </form>
    </div></section>
  </div>

  <header class="studio-section-heading"><div><small>Photographs</small><h2>Gallery images</h2></div></header>
  <section class="studio-stack">
    {data.images.length ? data.images.map((image) => (
      <article class="studio-item">
        <img class="studio-item-thumb" src={image.image_url} alt={image.alt_text} />
        <div class="studio-item-copy"><strong>{image.alt_text}</strong><small>{data.galleries.find((gallery) => gallery.id === image.gallery_id)?.title ?? 'Gallery'}</small></div>
        <div class="studio-item-actions">
          <button type="button" class="studio-button-quiet" data-studio-action="up" data-resource="images" data-id={image.id}>↑</button><button type="button" class="studio-button-quiet" data-studio-action="down" data-resource="images" data-id={image.id}>↓</button>
          <details class="studio-editor"><summary>Edit</summary><form class="studio-form studio-editor-form" data-studio-form data-resource="images" data-upload-kind="image">
            <input type="hidden" name="id" value={image.id} />
            <label class="wide"><span>Image description</span><input name="alt_text" value={image.alt_text} required /></label>
            <StudioMediaField kind="image" resource="images" label="Photograph" url={image.image_url} path={image.storage_path} currentId={image.id} />
            <div class="wide"><button type="submit">Save image</button></div><p class="studio-form-status wide" data-form-status></p>
          </form></details>
          <button type="button" class="studio-button-danger" data-studio-action="delete" data-resource="images" data-id={image.id}>Delete</button>
        </div>
      </article>
    )) : <p class="studio-empty">Add a gallery, then upload its photographs.</p>}
  </section>
</StudioAdminLayout>
