---
import StudioIcon from '../../components/StudioIcon.astro';
import StudioAdminLayout from '../../layouts/StudioAdminLayout.astro';
import { decideStudioAdminAccess, loadStudioSession } from '../../lib/studio';

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const auth = isPreview ? null : Astro.locals.auth();
const session = await loadStudioSession({ isPreview, userId: isPreview ? 'preview' : (auth?.userId ?? null), workspaceId: Astro.locals.siteContext.workspaceId, getToken: async () => auth ? (await auth.getToken()) ?? null : null });
const access = decideStudioAdminAccess(session, '/admin/media');
if (access.kind !== 'admin') return Astro.redirect(access.location);
const data = session.data!;
const formatBytes = (bytes: number) => bytes >= 1_048_576 ? `${(bytes / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;
const date = (value: string) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value));
const totalBytes = data.uploads.reduce((sum, item) => sum + item.size_bytes, 0);
---

<StudioAdminLayout title="Files" active="media" studioName={data.workspace?.name ?? 'Studio'} isPreview={isPreview} error={data.error} media={data.uploads}>
  <header class="studio-section-heading studio-section-heading--files">
    <div><small>Image library</small><h2>{data.uploads.length} files</h2></div>
    <div class="studio-heading-actions"><span>{formatBytes(totalBytes)} used</span><button class="studio-button" type="button" data-open-media-library><StudioIcon name="upload" />Add images</button></div>
  </header>
  {data.uploads.length ? (
    <section class="studio-file-grid" aria-label="Uploaded images">
      {data.uploads.map((file) => (
        <article class="studio-file-card" data-media-manage-card>
          <img src={file.public_url} alt="" loading="lazy" />
          <div class="studio-file-card__copy">
            <strong title={file.original_filename}>{file.original_filename}</strong>
            <small>{formatBytes(file.size_bytes)} · {date(file.created_at)}</small>
            <span>{file.used_in.length ? `Used in ${file.used_in.join(', ')}` : 'Not used yet'}</span>
          </div>
          <div class="studio-file-card__actions">
            <a href={file.public_url} target="_blank" rel="noreferrer">Open</a>
            <button type="button" data-media-delete={file.storage_path}>Delete</button>
          </div>
          <small class="studio-file-card__status" data-media-delete-status aria-live="polite"></small>
        </article>
      ))}
    </section>
  ) : (
    <section class="studio-file-empty">
      <StudioIcon name="media" />
      <h2>No files yet</h2>
      <p>Add photographs here, then choose them when you build a gallery or post.</p>
      <button class="studio-button" type="button" data-open-media-library>Add images</button>
    </section>
  )}
</StudioAdminLayout>
