---
import ClerkSignOutButton from '../../components/ClerkSignOutButton.astro';
import ClerkUI from '../../components/ClerkUI.astro';
import { loadStudioSession } from '../../lib/studio';
import '../../styles/studio-admin.css';

const auth = Astro.locals.auth();
const session = await loadStudioSession({
  isPreview: false,
  userId: auth?.userId ?? null,
  workspaceId: Astro.locals.siteContext.workspaceId,
  getToken: async () => auth ? (await auth.getToken()) ?? null : null,
});
if (!session.authenticated) return Astro.redirect('/sign-in?redirect_url=%2Fadmin');
if (session.authorized) return Astro.redirect('/admin');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Waiting for access</title>
  </head>
  <body>
    <main class="studio-access-screen">
      <section class="studio-access-card" role="status" aria-labelledby="studio-access-title">
        <div class="studio-access-card__account"><ClerkUI kind="user-button" /></div>
        <small>Studio access</small>
        <h1 id="studio-access-title">Your account is ready.</h1>
        <p>Leon will link this login as the site owner from his panel. After that you can edit the site, choose a domain, and see the monthly hosting bill.</p>
        <div>
          <a href="/">View website</a>
          <ClerkSignOutButton>Sign out</ClerkSignOutButton>
        </div>
      </section>
    </main>
  </body>
</html>
