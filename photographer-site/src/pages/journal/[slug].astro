---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { imagePresentationStyle } from '../../lib/content/presentation';
import { siteRepository } from '../../lib/content/repository';
import { isIshotyouuSite } from '../../lib/ishotyouu';

const ishotyouu = isIshotyouuSite(Astro.locals.siteContext);
const slug = Astro.params.slug ?? '';
const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const post = portfolio.posts.find((item) => item.slug === slug) ?? null;

if (!post) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const publishedAt = post
  ? new Intl.DateTimeFormat('en-US', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(post.publishedAt))
  : '';
---

<SiteLayout
  title={post?.title ?? 'Field note not found'}
  description={post?.excerpt ?? `The requested ${portfolio.studioName} field note could not be found.`}
  image={post?.cover?.src}
  canonicalPath={`/journal/${slug}`}
>
  {ishotyouu && post ? (
    <article class="page-shell">
      <header class="page-intro">
        <p class="section-kicker">{publishedAt}</p>
        <h1>{post.title}</h1>
      </header>
      {post.cover && (
        <figure class="about-frame">
          <img class="about-photo" src={post.cover.src} alt={post.cover.alt} loading="eager" />
        </figure>
      )}
      <div class="ishot-body">
        {post.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <nav class="journal-story-return">
        <a class="text-link" href="/journal">All posts</a>
      </nav>
    </article>
  ) : ishotyouu ? (
    <section class="page-shell" aria-labelledby="not-found-title">
      <p class="section-kicker">Journal</p>
      <h1 id="not-found-title">This post was not found.</h1>
      <p class="hint"><a class="text-link" href="/journal">Return to journal</a></p>
    </section>
  ) : (
  <>
  {
    post ? (
      <article class="journal-story">
        <header class="journal-story-intro page-gutter">
          <h1 data-entrance>{post.title}</h1>
          <time datetime={post.publishedAt} data-entrance>{publishedAt}</time>
        </header>

        {post.cover && (
          <figure class="journal-story-cover page-gutter" data-entrance style={imagePresentationStyle(post.cover)}>
            <span class="media-crop-layer">
              <img
                src={post.cover.src}
                alt={post.cover.alt}
                width={post.cover.width}
                height={post.cover.height}
                loading="eager"
                decoding="async"
              />
            </span>
          </figure>
        )}

        <div class="journal-story-body page-gutter">
          {post.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <nav class="journal-story-return page-gutter" aria-label="Field note navigation">
          {post.relatedGallerySlug && (
            <a class="text-link" href={`/work/${post.relatedGallerySlug}`}>Related gallery</a>
          )}
          <a class="text-link" href="/journal">All photography notes</a>
        </nav>
      </article>
    ) : (
      <section class="not-found page-gutter" aria-labelledby="not-found-title">
        <span class="eyebrow">Photography notes</span>
        <h1 id="not-found-title">This note was not found.</h1>
        <a class="text-link" href="/journal">Return to photography notes</a>
      </section>
    )
  }
  </>
  )}
</SiteLayout>
