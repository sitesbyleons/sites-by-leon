---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { demoRepository } from '../../lib/content/repository';

const slug = Astro.params.slug ?? '';
const post = await demoRepository.getPost(slug);

if (!post) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

const publishedAt = post
  ? new Intl.DateTimeFormat('en-US', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(post.publishedAt))
  : '';
---

<SiteLayout
  title={post?.title ?? 'Journal entry not found'}
  description={post?.excerpt ?? 'The requested Northline journal entry could not be found.'}
  image={post?.cover.src}
  canonicalPath={`/journal/${slug}`}
>
  {
    post ? (
      <article class="journal-story">
        <header class="journal-story-intro page-gutter">
          <div>
            <span class="eyebrow" data-entrance>Journal</span>
            <h1 data-entrance>{post.title}</h1>
          </div>
          <time datetime={post.publishedAt} data-entrance>{publishedAt}</time>
        </header>

        <figure class="journal-story-cover page-gutter" data-entrance>
          <img
            src={post.cover.src}
            alt={post.cover.alt}
            width={post.cover.width}
            height={post.cover.height}
            loading="eager"
            decoding="async"
          />
          {post.cover.caption && <figcaption>{post.cover.caption}</figcaption>}
        </figure>

        <div class="journal-story-body page-gutter">
          {post.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <nav class="journal-story-return page-gutter" aria-label="Journal navigation">
          {post.relatedGallerySlug && (
            <a class="text-link" href={`/work/${post.relatedGallerySlug}`}>See the related gallery</a>
          )}
          <a class="text-link" href="/journal">All journal entries</a>
        </nav>
      </article>
    ) : (
      <section class="not-found page-gutter" aria-labelledby="not-found-title">
        <span class="eyebrow">Journal</span>
        <h1 id="not-found-title">This journal entry isn't here.</h1>
        <a class="text-link" href="/journal">Return to the journal</a>
      </section>
    )
  }
</SiteLayout>

<style>
  .journal-story-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(12rem, 0.5fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 10rem);
    padding-top: clamp(10rem, 18vw, 16rem);
    padding-bottom: clamp(4.5rem, 9vw, 8rem);
    background: var(--ink);
    box-shadow: 0 0 0 100vmax var(--ink);
    clip-path: inset(0 -100vmax);
    color: var(--paper);
  }

  .journal-story-intro .eyebrow {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--silver);
  }

  .journal-story-intro h1 {
    max-width: 10ch;
    margin-bottom: 0;
    font-size: clamp(4rem, 9vw, 9rem);
    letter-spacing: -0.05em;
  }

  .journal-story-intro time {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-dark);
    color: var(--silver);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal-story-cover {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .journal-story-cover img {
    width: 100%;
    max-height: 52rem;
    object-fit: cover;
  }

  .journal-story-cover figcaption {
    margin-top: 0.8rem;
    color: #565961;
    font-size: 0.75rem;
  }

  .journal-story-body {
    max-width: 52rem;
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .journal-story-body p {
    margin-bottom: 1.5em;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    line-height: 1.45;
  }

  .journal-story-body p:last-child {
    margin-bottom: 0;
  }

  .journal-story-return {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  @media (max-width: 760px) {
    .journal-story-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 10rem;
    }

    .journal-story-intro h1 {
      font-size: clamp(3.8rem, 18vw, 6rem);
    }
  }
</style>
