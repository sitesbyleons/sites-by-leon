---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { siteRepository } from '../../lib/content/repository';

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const posts = (await siteRepository.listPosts()).map((post) => ({
  post,
  publishedAt: dateFormatter.format(new Date(post.publishedAt)),
}));
---

<SiteLayout
  title="Field Notes"
  description="Short field notes on sports photography from Northline Sports."
  image={posts[0]?.post.cover.src}
  canonicalPath="/journal"
>
  <header class="page-intro page-gutter">
    <h1 id="journal-title" data-entrance>Photography notes.</h1>
    <p data-entrance>Football, basketball, and track.</p>
  </header>

  <section class="journal-archive page-gutter" aria-label="Sports photography notes">
    <ol class="journal-list">
      {
        posts.map(({ post, publishedAt }) => (
          <li class="journal-card" data-entrance>
            <article>
              <a href={`/journal/${post.slug}`}>
                <figure>
                  <img
                    src={post.cover.src}
                    alt={post.cover.alt}
                    width={post.cover.width}
                    height={post.cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="journal-card-copy">
                  <time datetime={post.publishedAt}>{publishedAt}</time>
                  <h2>{post.title}</h2>
                  <p>{post.excerpt}</p>
                </div>
              </a>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</SiteLayout>
