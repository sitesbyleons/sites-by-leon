---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { imagePresentationStyle } from '../../lib/content/presentation';
import { siteRepository } from '../../lib/content/repository';
import { isIshotyouuSite } from '../../lib/ishotyouu';

const ishotyouu = isIshotyouuSite(Astro.locals.siteContext);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const posts = portfolio.posts.map((post) => ({
  post,
  publishedAt: dateFormatter.format(new Date(post.publishedAt)),
}));
---

<SiteLayout
  title="Field Notes"
  description={`Photography notes from ${portfolio.studioName}.`}
  image={posts[0]?.post.cover?.src}
  canonicalPath="/journal"
>
  {ishotyouu ? (
    <section class="page-shell" aria-labelledby="journal-title">
      <header class="page-intro">
        <p class="section-kicker">Journal</p>
        <h1 id="journal-title">Journal</h1>
        <p class="hint">{posts.length ? `${portfolio.studioName} notes.` : 'Publish a post in Studio admin and it shows here.'}</p>
      </header>
      {posts.length ? (
        <div class="ishot-stack">
          {posts.map(({ post, publishedAt }) => (
            <article class="ishot-card">
              <p class="ishot-meta"><time datetime={post.publishedAt}>{publishedAt}</time></p>
              <h2><a href={`/journal/${post.slug}`}>{post.title}</a></h2>
              <p>{post.excerpt}</p>
            </article>
          ))}
        </div>
      ) : (
        <p class="ishot-empty">No posts yet.</p>
      )}
    </section>
  ) : (
  <>
  <header class="page-intro page-gutter">
    <h1 id="journal-title" data-entrance>Photography notes.</h1>
    <p data-entrance>{portfolio.studioName}</p>
  </header>

  <section class="journal-archive page-gutter" aria-label={`${portfolio.studioName} photography notes`}>
    <ol class="journal-list">
      {
        posts.map(({ post, publishedAt }) => (
          <li class="journal-card" data-entrance>
            <article>
              <a href={`/journal/${post.slug}`}>
                {post.cover && (
                  <figure style={imagePresentationStyle(post.cover)}>
                    <span class="media-crop-layer">
                      <img
                        src={post.cover.src}
                        alt={post.cover.alt}
                        width={post.cover.width}
                        height={post.cover.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  </figure>
                )}
                <div class="journal-card-copy">
                  <time datetime={post.publishedAt}>{publishedAt}</time>
                  <h2>{post.title}</h2>
                  <p>{post.excerpt}</p>
                </div>
              </a>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
  </>
  )}
</SiteLayout>
