---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { demoRepository } from '../../lib/content/repository';

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const posts = (await demoRepository.listPosts()).map((post) => ({
  post,
  publishedAt: dateFormatter.format(new Date(post.publishedAt)),
}));
---

<SiteLayout
  title="Journal"
  description="Notes on portrait craft, preparation, and the value of photographs in print from Northline Portrait Studio."
  image={posts[0]?.post.cover.src}
  canonicalPath="/journal"
>
  <header class="journal-intro page-gutter">
    <p class="eyebrow" data-entrance>Journal</p>
    <div>
      <h1 id="journal-title" data-entrance>Notes from behind the portrait.</h1>
      <p data-entrance>Field notes on light, preparation, and making photographs meant to last.</p>
    </div>
  </header>

  <section class="journal-archive page-gutter" aria-label="Journal entries">
    <ol class="journal-list">
      {
        posts.map(({ post, publishedAt }) => (
          <li class="journal-card" data-entrance>
            <article>
              <a href={`/journal/${post.slug}`}>
                <figure>
                  <img
                    src={post.cover.src}
                    alt={post.cover.alt}
                    width={post.cover.width}
                    height={post.cover.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <div class="journal-card-copy">
                  <time datetime={post.publishedAt}>{publishedAt}</time>
                  <h2>{post.title}</h2>
                  <p>{post.excerpt}</p>
                </div>
              </a>
            </article>
          </li>
        ))
      }
    </ol>
  </section>
</SiteLayout>

<style>
  .journal-intro {
    display: grid;
    grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(2rem, 8vw, 10rem);
    padding-top: clamp(10rem, 18vw, 16rem);
    padding-bottom: clamp(4.5rem, 9vw, 8rem);
    background: var(--ink);
    box-shadow: 0 0 0 100vmax var(--ink);
    clip-path: inset(0 -100vmax);
    color: var(--paper);
  }

  .journal-intro .eyebrow {
    color: var(--silver);
  }

  .journal-intro h1 {
    max-width: 10ch;
    margin-bottom: 0;
    font-size: clamp(4rem, 9vw, 9rem);
    letter-spacing: -0.05em;
  }

  .journal-intro div > p {
    max-width: 38rem;
    margin: 2.5rem 0 0 auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-dark);
  }

  .journal-archive {
    padding-top: clamp(5rem, 10vw, 9rem);
    padding-bottom: clamp(6rem, 12vw, 12rem);
  }

  .journal-list {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(3rem, 7vw, 8rem) clamp(1.5rem, 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journal-card:nth-child(3n + 1) {
    grid-column: 1 / 7;
  }

  .journal-card:nth-child(3n + 2) {
    grid-column: 8 / 13;
    padding-top: clamp(5rem, 10vw, 10rem);
  }

  .journal-card:nth-child(3n) {
    grid-column: 3 / 10;
  }

  .journal-card a {
    display: block;
    text-decoration: none;
  }

  .journal-card figure {
    overflow: hidden;
    margin: 0;
    background: var(--ink);
  }

  .journal-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: filter 350ms ease, transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .journal-card a:hover img,
  .journal-card a:focus-visible img {
    filter: saturate(1.08);
    transform: scale(1.018);
  }

  .journal-card-copy {
    padding-top: 1.25rem;
  }

  .journal-card time {
    color: #565961;
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal-card h2 {
    margin: 0.75rem 0 0.8rem;
    font-size: clamp(2.2rem, 4vw, 4.5rem);
  }

  .journal-card p {
    max-width: 42rem;
    margin-bottom: 0;
    color: #565961;
  }

  @media (max-width: 760px) {
    .journal-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-top: 10rem;
    }

    .journal-intro h1 {
      font-size: clamp(3.8rem, 18vw, 6rem);
    }

    .journal-intro div > p {
      margin-left: 0;
    }

    .journal-list {
      display: block;
    }

    .journal-card,
    .journal-card:nth-child(3n + 1),
    .journal-card:nth-child(3n + 2),
    .journal-card:nth-child(3n) {
      margin-bottom: 4rem;
      padding-top: 0;
    }

    .journal-card:nth-child(even) {
      margin-left: 10vw;
    }

    .journal-card:nth-child(odd) {
      margin-right: 5vw;
    }
  }
</style>
