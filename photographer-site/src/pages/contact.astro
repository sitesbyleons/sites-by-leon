---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteRepository } from '../lib/content/repository';
import { isIshotyouuSite } from '../lib/ishotyouu';

if (isIshotyouuSite(Astro.locals.siteContext)) {
  return Astro.redirect(`/inquire${Astro.url.search}`, 302);
}

const portfolio = await siteRepository.getPortfolio(Astro.locals.siteContext.workspaceId);
const inquiryEndpoint = '/api/inquiry';
const minimumDate = new Date().toISOString().slice(0, 10);
---

<SiteLayout
  title="Contact"
  description={`Contact ${portfolio.studioName} about photography coverage.`}
  canonicalPath="/contact"
>
  <section class="contact-page page-gutter" aria-labelledby="contact-page-title">
    <header class="contact-intro" data-entrance>
      <h1 id="contact-page-title">{portfolio.home.contactLabel}</h1>
      <p>Tell us what you need covered.</p>
    </header>

    <form
      class="inquiry-form"
      data-inquiry-form
      data-endpoint={inquiryEndpoint}
      data-email={portfolio.email}
      data-studio-name={portfolio.studioName}
      novalidate
    >
      <div class="inquiry-field inquiry-field--wide">
        <label for="inquiry-name">Name</label>
        <input id="inquiry-name" name="name" autocomplete="name" minlength="2" maxlength="120" required />
        <small data-field-error="name"></small>
      </div>

      <div class="inquiry-field">
        <label for="inquiry-email">Email</label>
        <input id="inquiry-email" name="email" type="email" autocomplete="email" maxlength="254" />
        <small data-field-error="email"></small>
      </div>

      <div class="inquiry-field">
        <label for="inquiry-phone">Phone</label>
        <input id="inquiry-phone" name="phone" type="tel" autocomplete="tel" maxlength="32" />
        <small data-field-error="phone"></small>
      </div>

      <p class="contact-method-error" data-contact-method-error aria-live="polite"></p>

      <div class="inquiry-field inquiry-field--wide">
        <label for="inquiry-date">Desired date</label>
        <input id="inquiry-date" name="desiredDate" type="date" min={minimumDate} required />
        <small data-field-error="desiredDate"></small>
      </div>

      <div class="inquiry-field inquiry-field--wide">
        <label for="inquiry-message">Message</label>
        <textarea id="inquiry-message" name="message" rows="6" minlength="10" maxlength="3000" required></textarea>
        <small data-field-error="message"></small>
      </div>

      <div class="inquiry-honeypot" aria-hidden="true">
        <label for="inquiry-company">Company</label>
        <input id="inquiry-company" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="inquiry-actions inquiry-field--wide">
        <button type="submit">Send inquiry</button>
        <p data-inquiry-status aria-live="polite"></p>
      </div>
    </form>

    {
      portfolio.email && (
        <p class="contact-email" data-entrance>
          Or email <a href={`mailto:${portfolio.email}`}>{portfolio.email}</a>
        </p>
      )
    }
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
    const status = document.querySelector<HTMLElement>('[data-inquiry-status]');
    const contactError = document.querySelector<HTMLElement>('[data-contact-method-error]');

    const setFieldErrors = (errors: Record<string, string> = {}) => {
      form?.querySelectorAll<HTMLElement>('[data-field-error]').forEach((element) => {
        const key = element.dataset.fieldError ?? '';
        element.textContent = errors[key] ?? '';
      });
    };

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status || !contactError) return;
      status.textContent = '';
      contactError.textContent = '';
      setFieldErrors();

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const phone = String(data.get('phone') ?? '').trim();
      if (!email && !phone) {
        contactError.textContent = 'Enter an email address or phone number.';
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const endpoint = form.dataset.endpoint ?? '';
      if (!endpoint) {
        status.textContent = `Form not connected yet. Email ${form.dataset.email}.`;
        return;
      }

      status.textContent = 'Sending...';
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email,
          phone,
          desiredDate: data.get('desiredDate'),
          message: data.get('message'),
          company: data.get('company'),
        }),
      }).catch(() => null);

      const payload = await response?.json().catch(() => null);
      if (!response?.ok) {
        setFieldErrors(payload?.errors);
        status.textContent = response?.status === 429
          ? 'Too many attempts. Try again in a few minutes.'
          : 'Inquiry not sent. Please use the email below.';
        return;
      }

      form.reset();
      const studioName = form.dataset.studioName || 'The studio';
      status.textContent = `Inquiry sent. ${studioName} will follow up soon.`;
    });
  </script>
</SiteLayout>
