---
import ClerkUI from '../components/ClerkUI.astro';
import StudioIcon from '../components/StudioIcon.astro';
import { isIshotyouuSite } from '../lib/ishotyouu';
import type { StudioUpload } from '../lib/studio';
import '../styles/studio-admin.css';

interface Props {
  title: string;
  active: 'overview' | 'content' | 'media' | 'galleries' | 'posts' | 'services' | 'clients' | 'invoices' | 'inquiries' | 'support';
  studioName: string;
  isPreview: boolean;
  error?: string | null;
  workspaceId?: string;
  media?: StudioUpload[];
}

const { title, active, studioName, isPreview, error = null, workspaceId = '', media = [] } = Astro.props;
const suffix = isPreview ? '?preview=true' : '';
const ishotyouu = isIshotyouuSite(Astro.locals.siteContext);
const groups = ishotyouu
  ? [
    {
      label: 'Studio',
      links: [
        { key: 'overview', label: 'Overview', href: `/admin${suffix}` },
        { key: 'content', label: 'Homepage', href: `/admin/content${suffix}` },
        { key: 'media', label: 'Files', href: `/admin/media${suffix}` },
      ],
    },
    {
      label: 'Business',
      links: [
        { key: 'inquiries', label: 'Inquiries', href: `/admin/inquiries${suffix}` },
        { key: 'clients', label: 'Clients', href: `/admin/clients${suffix}` },
        { key: 'services', label: 'Services', href: `/admin/services${suffix}` },
        { key: 'invoices', label: 'Invoices', href: `/admin/invoices${suffix}` },
      ],
    },
  ]
  : [
    {
      label: 'Studio',
      links: [
        { key: 'overview', label: 'Overview', href: `/admin${suffix}` },
        { key: 'content', label: 'Homepage', href: `/admin/content${suffix}` },
        { key: 'media', label: 'Files', href: `/admin/media${suffix}` },
        { key: 'galleries', label: 'Galleries', href: `/admin/galleries${suffix}` },
        { key: 'posts', label: 'Posts', href: `/admin/posts${suffix}` },
      ],
    },
    {
      label: 'Business',
      links: [
        { key: 'inquiries', label: 'Inquiries', href: `/admin/inquiries${suffix}` },
        { key: 'clients', label: 'Clients', href: `/admin/clients${suffix}` },
        { key: 'services', label: 'Services', href: `/admin/services${suffix}` },
        { key: 'invoices', label: 'Invoices', href: `/admin/invoices${suffix}` },
      ],
    },
  ];
const formatBytes = (bytes: number) => bytes >= 1_048_576
  ? `${(bytes / 1_048_576).toFixed(1)} MB`
  : `${Math.max(1, Math.round(bytes / 1024))} KB`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="dark light" />
    <title>{title} | {studioName}</title>
  </head>
  <body data-preview={isPreview ? 'true' : 'false'} data-workspace-id={workspaceId}>
    <div class="studio-shell">
      <aside class="studio-sidebar" data-studio-sidebar>
        <div class="studio-sidebar__head">
          <a class="studio-brand" href={`/admin${suffix}`}>
            <span class="studio-brand__mark">{studioName.slice(0, 1).toUpperCase()}</span>
            <span><strong>{studioName}</strong><small>Studio workspace</small></span>
          </a>
          <button class="studio-nav-close" type="button" data-studio-nav-toggle aria-label="Close navigation"><StudioIcon name="close" /></button>
        </div>

        <nav aria-label="Studio admin">
          {groups.map((group) => (
            <div class="studio-nav-group">
              <small>{group.label}</small>
              {group.links.map((link) => (
                <a href={link.href} aria-current={active === link.key ? 'page' : undefined}>
                  <StudioIcon name={link.key} /><span>{link.label}</span>
                </a>
              ))}
            </div>
          ))}
          <div class="studio-nav-group studio-nav-group--support">
            <a href={`/admin/support${suffix}`} aria-current={active === 'support' ? 'page' : undefined}>
              <StudioIcon name="support" /><span>Support</span>
            </a>
          </div>
        </nav>

        <a class="studio-public-link" href="/" target="_blank" rel="noreferrer"><StudioIcon name="external" /><span>View website</span></a>
      </aside>
      <button class="studio-nav-scrim" type="button" data-studio-nav-toggle aria-label="Close navigation"></button>

      <main class="studio-main">
        <header class="studio-topbar">
          <button class="studio-nav-open" type="button" data-studio-nav-toggle aria-label="Open navigation"><StudioIcon name="menu" /></button>
          <div><small>Workspace / {title}</small><h1>{title}</h1></div>
          <div class="studio-topbar__tools">
            <button class="studio-topbar__files" type="button" data-open-media-library><StudioIcon name="media" /><span>Files</span></button>
            {!isPreview && <ClerkUI kind="user-button" />}
          </div>
        </header>
        {error && <p class="studio-notice" role="status">{error}</p>}
        <div class="studio-workspace"><slot /></div>
      </main>
    </div>

    <dialog class="studio-media-dialog" data-media-dialog>
      <div class="studio-media-dialog__shell">
        <header>
          <div><small>Studio files</small><h2>Choose an image</h2></div>
          <button type="button" data-media-close aria-label="Close files"><StudioIcon name="close" /></button>
        </header>
        <div class="studio-media-toolbar">
          <label class="studio-media-search"><StudioIcon name="search" /><input type="search" placeholder="Search files" data-media-search /></label>
          <div class="studio-media-filters" aria-label="Filter files">
            <button type="button" data-media-filter="all" aria-pressed="true">All</button>
            {ishotyouu ? (
              <button type="button" data-media-filter="library" aria-pressed="false">Instagram</button>
            ) : (
              <>
                <button type="button" data-media-filter="galleries" aria-pressed="false">Galleries</button>
                <button type="button" data-media-filter="covers" aria-pressed="false">Covers</button>
                <button type="button" data-media-filter="posts" aria-pressed="false">Posts</button>
              </>
            )}
          </div>
          <label class="studio-upload-button"><StudioIcon name="upload" /><span>Add images</span><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-media-upload /></label>
        </div>
        <p class="studio-media-dialog__status" data-media-dialog-status aria-live="polite"></p>
        <div class="studio-media-browser" data-media-browser>
          {media.map((file) => (
            <button
              class="studio-media-card"
              type="button"
              data-media-card
              data-media-path={file.storage_path}
              data-media-url={file.public_url}
              data-media-kind={file.media_kind}
              data-media-name={file.original_filename.toLowerCase()}
              data-media-used-in={file.used_in.join(',')}
            >
              <img src={file.public_url} alt="" loading="lazy" />
              <span><strong>{file.original_filename}</strong><small>{formatBytes(file.size_bytes)}{file.used_in.length ? ` · Used in ${file.used_in.join(', ')}` : ''}</small></span>
            </button>
          ))}
          {!media.length && <p class="studio-media-empty" data-media-empty>Add your first image to start the file library.</p>}
        </div>
      </div>
    </dialog>

    <script>
      const dialog = document.querySelector<HTMLDialogElement>('[data-media-dialog]');
      const mediaBrowser = document.querySelector<HTMLElement>('[data-media-browser]');
      const dialogStatus = document.querySelector<HTMLElement>('[data-media-dialog-status]');
      const mediaUpload = document.querySelector<HTMLInputElement>('[data-media-upload]');
      const mediaSearch = document.querySelector<HTMLInputElement>('[data-media-search]');
      let activeMediaPicker: HTMLButtonElement | null = null;
      let activeMediaFilter = 'all';

      const updateCropEditor = (editor: HTMLElement) => {
        const preview = editor.querySelector<HTMLElement>('[data-crop-preview]');
        const image = editor.querySelector<HTMLImageElement>('[data-crop-preview-image]');
        const aspect = editor.querySelector<HTMLSelectElement>('[data-crop-aspect]')?.value ?? 'landscape';
        const resolvedAspect = aspect === 'inherit' ? editor.dataset.inheritedAspect ?? 'landscape' : aspect;
        const x = editor.querySelector<HTMLInputElement>('[data-crop-x]')?.value ?? '50';
        const y = editor.querySelector<HTMLInputElement>('[data-crop-y]')?.value ?? '50';
        const zoom = editor.querySelector<HTMLInputElement>('[data-crop-zoom]')?.value ?? '1';
        if (preview) preview.dataset.ratio = resolvedAspect;
        if (image) {
          image.style.setProperty('--crop-x', `${x}%`);
          image.style.setProperty('--crop-y', `${y}%`);
          image.style.setProperty('--crop-zoom', zoom);
        }
        const xOutput = editor.querySelector<HTMLOutputElement>('[data-crop-output="x"]');
        const yOutput = editor.querySelector<HTMLOutputElement>('[data-crop-output="y"]');
        const zoomOutput = editor.querySelector<HTMLOutputElement>('[data-crop-output="zoom"]');
        if (xOutput) xOutput.value = x;
        if (yOutput) yOutput.value = y;
        if (zoomOutput) zoomOutput.value = `${Number(zoom).toFixed(2)}×`;
      };

      const setCropPreviewImage = (form: HTMLFormElement, url: string) => {
        const editor = form.querySelector<HTMLElement>('[data-crop-editor]');
        const preview = editor?.querySelector<HTMLElement>('[data-crop-preview]');
        if (!editor || !preview || !url) return;
        let image = preview.querySelector<HTMLImageElement>('[data-crop-preview-image]');
        if (!image) {
          image = document.createElement('img');
          image.alt = 'Crop preview';
          image.dataset.cropPreviewImage = '';
          preview.replaceChildren(image);
        }
        image.src = url;
        updateCropEditor(editor);
      };

      document.querySelectorAll<HTMLElement>('[data-crop-editor]').forEach((editor) => {
        editor.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((control) => {
          control.addEventListener('input', () => updateCropEditor(editor));
          control.addEventListener('change', () => updateCropEditor(editor));
        });
        updateCropEditor(editor);
      });

      const updateLayoutEditor = (editor: HTMLElement) => {
        const preview = editor.querySelector<HTMLElement>('[data-layout-preview]');
        if (!preview) return;
        preview.dataset.mode = editor.querySelector<HTMLSelectElement>('[data-layout-mode]')?.value ?? 'grid';
        preview.dataset.columns = editor.querySelector<HTMLSelectElement>('[data-layout-columns]')?.value ?? '3';
        preview.dataset.ratio = editor.querySelector<HTMLSelectElement>('[data-layout-ratio]')?.value ?? 'landscape';
      };

      document.querySelectorAll<HTMLElement>('[data-layout-editor]').forEach((editor) => {
        editor.querySelectorAll<HTMLSelectElement>('select').forEach((control) => {
          control.addEventListener('change', () => updateLayoutEditor(editor));
        });
        updateLayoutEditor(editor);
      });

      document.querySelectorAll<HTMLSelectElement>('select[name="gallery_id"]').forEach((select) => {
        select.addEventListener('change', () => {
          const editor = select.form?.querySelector<HTMLElement>('[data-crop-editor]');
          const option = select.selectedOptions[0];
          if (!editor) return;
          editor.dataset.inheritedAspect = option?.dataset.imageAspect ?? 'landscape';
          updateCropEditor(editor);
        });
      });

      const openMediaDialog = (picker: HTMLButtonElement | null = null) => {
        activeMediaPicker = picker;
        if (dialogStatus) dialogStatus.textContent = '';
        const heading = dialog?.querySelector('h2');
        if (heading) heading.textContent = picker ? 'Choose an image' : 'Your image library';
        dialog?.showModal();
      };

      document.querySelectorAll<HTMLButtonElement>('[data-studio-nav-toggle]').forEach((button) => {
        button.addEventListener('click', () => document.body.classList.toggle('studio-nav-visible'));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-media-picker]').forEach((button) => {
        button.addEventListener('click', () => openMediaDialog(button));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-open-media-library]').forEach((button) => {
        button.addEventListener('click', () => openMediaDialog());
      });
      document.querySelectorAll<HTMLButtonElement>('[data-media-close]').forEach((button) => {
        button.addEventListener('click', () => dialog?.close());
      });
      dialog?.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      const applyMediaFilters = () => {
        const query = mediaSearch?.value.trim().toLowerCase() ?? '';
        document.querySelectorAll<HTMLButtonElement>('[data-media-card]').forEach((card) => {
          const matchesKind = activeMediaFilter === 'all' || card.dataset.mediaKind === activeMediaFilter;
          const matchesSearch = !query || (card.dataset.mediaName ?? '').includes(query);
          card.hidden = !matchesKind || !matchesSearch;
        });
      };
      document.querySelectorAll<HTMLButtonElement>('[data-media-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          activeMediaFilter = button.dataset.mediaFilter ?? 'all';
          document.querySelectorAll<HTMLButtonElement>('[data-media-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          applyMediaFilters();
        });
      });
      mediaSearch?.addEventListener('input', applyMediaFilters);

      const chooseMedia = (card: HTMLButtonElement) => {
        if (!activeMediaPicker) return;
        const field = activeMediaPicker.closest<HTMLElement>('[data-media-field]');
        const form = activeMediaPicker.closest<HTMLFormElement>('form');
        if (!field || !form) return;
        const pathName = form.dataset.uploadKind === 'image' ? 'storage_path' : 'cover_storage_path';
        const urlName = form.dataset.uploadKind === 'image' ? 'image_url' : 'cover_image_url';
        const pathField = form.elements.namedItem(pathName) as HTMLInputElement | null;
        const urlField = form.elements.namedItem(urlName) as HTMLInputElement | null;
        const selectedPath = card.dataset.mediaPath ?? '';
        const usedIn = (card.dataset.mediaUsedIn ?? '').split(',').filter(Boolean);
        const resource = activeMediaPicker.dataset.mediaResource ?? '';
        const status = field.querySelector<HTMLElement>('[data-media-field-status]');
        if (selectedPath && usedIn.includes(resource) && pathField?.value !== selectedPath) {
          if (dialogStatus) dialogStatus.textContent = `That file is already used in another ${resource === 'images' ? 'gallery image' : resource.slice(0, -1)}. Choose another file.`;
          return;
        }
        if (pathField) pathField.value = selectedPath;
        if (urlField) urlField.value = card.dataset.mediaUrl ?? '';
        const preview = field.querySelector<HTMLElement>('[data-media-preview]');
        if (preview) {
          preview.replaceChildren();
          const image = document.createElement('img');
          image.src = card.dataset.mediaUrl ?? '';
          image.alt = '';
          preview.append(image);
        }
        setCropPreviewImage(form, card.dataset.mediaUrl ?? '');
        const copy = activeMediaPicker.querySelector('strong');
        if (copy) copy.textContent = 'Change image';
        if (status) status.textContent = card.dataset.mediaName ?? 'Image selected';
        dialog?.close();
      };

      mediaBrowser?.addEventListener('click', (event) => {
        const card = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-media-card]');
        if (card) chooseMedia(card);
      });

      const addMediaCard = (file: { path: string; publicUrl: string; filename: string; kind: string; size: number }) => {
        if (!mediaBrowser) return null;
        mediaBrowser.querySelector('[data-media-empty]')?.remove();
        const card = document.createElement('button');
        card.type = 'button';
        card.className = 'studio-media-card';
        card.dataset.mediaCard = '';
        card.dataset.mediaPath = file.path;
        card.dataset.mediaUrl = file.publicUrl;
        card.dataset.mediaKind = file.kind;
        card.dataset.mediaName = file.filename.toLowerCase();
        card.dataset.mediaUsedIn = '';
        const image = document.createElement('img');
        image.src = file.publicUrl;
        image.alt = '';
        const copy = document.createElement('span');
        const name = document.createElement('strong');
        name.textContent = file.filename;
        const size = document.createElement('small');
        size.textContent = file.size >= 1_048_576 ? `${(file.size / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(file.size / 1024))} KB`;
        copy.append(name, size);
        card.append(image, copy);
        mediaBrowser.prepend(card);
        return card;
      };

      mediaUpload?.addEventListener('change', async () => {
        const files = [...(mediaUpload.files ?? [])];
        if (!files.length || !dialogStatus) return;
        const allowed = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/avif']);
        const invalid = files.find((file) => !allowed.has(file.type) || file.size < 1 || file.size > 15 * 1024 * 1024);
        if (invalid) { dialogStatus.textContent = 'Choose JPG, PNG, WebP, or AVIF images smaller than 15 MB.'; mediaUpload.value = ''; return; }
        if (document.body.dataset.preview === 'true') { dialogStatus.textContent = 'Uploads are disabled in preview.'; mediaUpload.value = ''; return; }
        const uploadKind = activeMediaPicker?.dataset.mediaUploadKind ?? 'galleries';
        let firstCard: HTMLButtonElement | null = null;
        for (let index = 0; index < files.length; index += 1) {
          dialogStatus.textContent = `Uploading ${index + 1} of ${files.length}...`;
          const body = new FormData();
          body.append('file', files[index]);
          body.append('kind', uploadKind);
          body.append('retain', 'true');
          const response = await fetch('/api/admin/upload', { method: 'POST', body }).catch(() => null);
          const payload = await response?.json().catch(() => null);
          if (!response?.ok || !payload?.path || !payload?.publicUrl) {
            dialogStatus.textContent = payload?.message ?? 'An image could not be uploaded.';
            mediaUpload.value = '';
            return;
          }
          firstCard ??= addMediaCard(payload);
        }
        dialogStatus.textContent = files.length === 1 ? 'Image added.' : `${files.length} images added.`;
        mediaUpload.value = '';
        if (activeMediaPicker && firstCard) chooseMedia(firstCard);
      });

      const uploadImage = async (form: HTMLFormElement) => {
        const input = form.querySelector<HTMLInputElement>('[data-image-upload]');
        const file = input?.files?.[0];
        if (!file) return null;
        const urlField = form.elements.namedItem(form.dataset.uploadKind === 'image' ? 'image_url' : 'cover_image_url') as HTMLInputElement | null;
        const pathField = form.elements.namedItem(form.dataset.uploadKind === 'image' ? 'storage_path' : 'cover_storage_path') as HTMLInputElement | null;
        const signature = `${file.name}:${file.size}:${file.lastModified}`;
        if (form.dataset.pendingUploadSignature === signature && form.dataset.pendingUploadPath && pathField?.value === form.dataset.pendingUploadPath) return form.dataset.pendingUploadPath;
        const allowed = new Set(['image/jpeg', 'image/png', 'image/webp', 'image/avif']);
        if (!allowed.has(file.type)) throw new Error('Choose a JPG, PNG, WebP, or AVIF image.');
        if (file.size > 15 * 1024 * 1024) throw new Error('Choose an image smaller than 15 MB.');
        const kind = form.dataset.uploadKind === 'image' ? 'galleries' : form.dataset.uploadKind === 'post' ? 'posts' : 'covers';
        const upload = new FormData();
        upload.append('file', file);
        upload.append('kind', kind);
        const response = await fetch('/api/admin/upload', { method: 'POST', body: upload });
        const approved = await response.json().catch(() => null);
        if (!response.ok || !approved?.path || !approved?.publicUrl) throw new Error(approved?.message ?? 'Image could not be uploaded.');
        if (!form.dataset.previousUploadCaptured) {
          form.dataset.previousUploadCaptured = 'true';
          form.dataset.previousUploadUrl = urlField?.value ?? '';
          form.dataset.previousUploadPath = pathField?.value ?? '';
        }
        if (urlField) urlField.value = approved.publicUrl;
        if (pathField) pathField.value = approved.path;
        setCropPreviewImage(form, approved.publicUrl);
        form.dataset.pendingUploadSignature = signature;
        form.dataset.pendingUploadPath = approved.path;
        return approved.path as string;
      };

      const rememberOpenGallery = (galleryId: string | undefined) => {
        if (galleryId) window.sessionStorage.setItem('studio:open-gallery', galleryId);
      };

      const activateCreatedGallery = (form: HTMLFormElement, galleryId: string) => {
        const editor = form.closest<HTMLElement>('[data-gallery-editor-id]');
        const stage = editor?.querySelector<HTMLElement>('[data-gallery-photo-stage]');
        const galleryIdField = form.querySelector<HTMLInputElement>('[data-gallery-id-input]');
        const photoIdField = editor?.querySelector<HTMLInputElement>('[data-gallery-photo-id]');
        const photoForm = photoIdField?.closest<HTMLFormElement>('form');
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (editor) editor.dataset.galleryEditorId = galleryId;
        if (stage) stage.hidden = false;
        if (galleryIdField) galleryIdField.value = galleryId;
        if (photoIdField) photoIdField.value = galleryId;
        if (photoForm) photoForm.dataset.reopenGallery = galleryId;
        form.dataset.reopenGallery = galleryId;
        delete form.dataset.galleryCreate;
        if (submit) submit.textContent = 'Save details';
        const adder = stage?.querySelector<HTMLDetailsElement>('.studio-photo-adder');
        if (adder) adder.open = true;
      };

      document.querySelectorAll<HTMLElement>('.studio-editor-form').forEach((editor) => {
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'studio-editor-close';
        close.textContent = 'Close';
        close.addEventListener('click', () => editor.closest('details.studio-editor')?.removeAttribute('open'));
        editor.prepend(close);
      });

      const pendingGallery = window.sessionStorage.getItem('studio:open-gallery');
      if (pendingGallery) {
        window.sessionStorage.removeItem('studio:open-gallery');
        const editor = document.querySelector<HTMLDetailsElement>(`[data-gallery-editor-id="${CSS.escape(pendingGallery)}"]`);
        if (editor) editor.open = true;
      }
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') document.querySelectorAll('details.studio-editor[open]').forEach((editor) => editor.removeAttribute('open'));
      });

      document.querySelectorAll<HTMLFormElement>('[data-studio-form]').forEach((form) => {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const status = form.querySelector<HTMLElement>('[data-form-status]');
          if (!status) return;
          status.textContent = 'Saving...';
          if (document.body.dataset.preview === 'true') {
            if (form.dataset.galleryCreate === 'true') {
              activateCreatedGallery(form, 'preview-new-gallery');
              status.textContent = 'Gallery created in preview. Add photos below.';
              return;
            }
            status.textContent = 'Preview saved locally. Sign in to save real changes.';
            return;
          }
          const resource = form.dataset.resource;
          let uploadedPath: string | null = null;
          try { uploadedPath = await uploadImage(form); } catch (error) { status.textContent = error instanceof Error ? error.message : 'Image could not be uploaded.'; return; }
          const data = Object.fromEntries(new FormData(form).entries());
          Object.keys(data).forEach((key) => { if (data[key] instanceof File) delete data[key]; });
          const response = await fetch(`/api/admin/${resource}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) }).catch(() => null);
          const payload = await response?.json().catch(() => null);
          if (!response?.ok) {
            const definiteRejection = Boolean(response && response.status >= 400 && response.status < 500);
            if (uploadedPath && definiteRejection) {
              await fetch('/api/admin/upload', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: uploadedPath }) });
              const urlField = form.elements.namedItem(form.dataset.uploadKind === 'image' ? 'image_url' : 'cover_image_url') as HTMLInputElement | null;
              const pathField = form.elements.namedItem(form.dataset.uploadKind === 'image' ? 'storage_path' : 'cover_storage_path') as HTMLInputElement | null;
              if (urlField) urlField.value = form.dataset.previousUploadUrl ?? '';
              if (pathField) pathField.value = form.dataset.previousUploadPath ?? '';
              delete form.dataset.pendingUploadSignature;
              delete form.dataset.pendingUploadPath;
              delete form.dataset.previousUploadCaptured;
              delete form.dataset.previousUploadUrl;
              delete form.dataset.previousUploadPath;
            }
            status.textContent = payload?.message ?? (definiteRejection ? 'Changes were not saved.' : 'The connection ended before confirmation. Press Save again.');
            return;
          }
          status.textContent = 'Saved.';
          if (form.dataset.galleryCreate === 'true' && typeof payload?.id === 'string') {
            activateCreatedGallery(form, payload.id);
            status.textContent = 'Gallery created. Add photos below.';
            return;
          }
          rememberOpenGallery(form.dataset.reopenGallery);
          if (payload?.reload !== false) window.setTimeout(() => window.location.reload(), 450);
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-studio-action]').forEach((button) => {
        button.addEventListener('click', async () => {
          const resource = button.dataset.resource;
          const id = button.dataset.id;
          const action = button.dataset.studioAction;
          if (!resource || !id || !action) return;
          if (action === 'delete' && !window.confirm('Delete this item? This cannot be undone.')) return;
          if (document.body.dataset.preview === 'true') { button.textContent = 'Preview only'; return; }
          button.disabled = true;
          const response = await fetch(`/api/admin/${resource}`, { method: action === 'delete' ? 'DELETE' : 'PATCH', headers: { 'content-type': 'application/json' }, body: JSON.stringify(action === 'delete' ? { id } : { id, direction: action }) }).catch(() => null);
          if (!response?.ok) {
            const payload = await response?.json().catch(() => null);
            button.disabled = false;
            button.textContent = payload?.message ?? 'Try again';
            return;
          }
          rememberOpenGallery(button.dataset.reopenGallery);
          window.location.reload();
        });
      });

      document.querySelectorAll<HTMLButtonElement>('[data-media-delete]').forEach((button) => {
        button.addEventListener('click', async () => {
          if (!window.confirm('Delete this file?')) return;
          if (document.body.dataset.preview === 'true') { button.textContent = 'Preview only'; return; }
          button.disabled = true;
          const response = await fetch('/api/admin/upload', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ path: button.dataset.mediaDelete }) }).catch(() => null);
          const payload = await response?.json().catch(() => null);
          const status = button.closest<HTMLElement>('[data-media-manage-card]')?.querySelector<HTMLElement>('[data-media-delete-status]');
          if (!response?.ok) { if (status) status.textContent = payload?.message ?? 'File not deleted.'; button.disabled = false; return; }
          if (payload?.retained) { if (status) status.textContent = 'This file is in use. Remove it from the page first.'; button.disabled = false; return; }
          button.closest('[data-media-manage-card]')?.remove();
        });
      });
    </script>
  </body>
</html>
