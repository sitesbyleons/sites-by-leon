---
import { loadSiteTheme, siteRepository } from '../lib/content/repository';
import { isIshotyouuSite } from '../lib/ishotyouu';
import IshotyouuLayout from './IshotyouuLayout.astro';
import NorthlineLayout from './NorthlineLayout.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
}

const { title, description, image, canonicalPath } = Astro.props;
const { workspaceId, canonicalOrigin } = Astro.locals.siteContext;
const useIshotyouu = isIshotyouuSite(Astro.locals.siteContext);
const [portfolio, theme] = await Promise.all([
  siteRepository.getPortfolio(workspaceId),
  loadSiteTheme(workspaceId),
]);
const pageTitle = title === portfolio.studioName ? title : `${title} - ${portfolio.studioName}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, `${canonicalOrigin}/`);
const socialImage = image ? new URL(image, `${canonicalOrigin}/`) : undefined;
---

{useIshotyouu ? (
  <IshotyouuLayout
    title={title}
    description={description}
    image={image}
    canonicalPath={canonicalPath}
    studioName={portfolio.studioName}
    canonicalOrigin={canonicalOrigin}
  >
    <slot />
  </IshotyouuLayout>
) : (
  <NorthlineLayout
    title={pageTitle}
    description={description}
    canonical={canonical}
    socialImage={socialImage}
    studioName={portfolio.studioName}
    email={portfolio.email}
    fontPreset={theme.fontPreset}
    paperColor={theme.paperColor}
    inkColor={theme.inkColor}
    accentColor={theme.accentColor}
  >
    <slot />
  </NorthlineLayout>
)}
