{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm install --no-package-lock",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://sites-by-leon-dashboard.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/admin/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://sites-by-leon-dashboard.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/dashboard/:path*"
    },
    {
      "source": "/sign-in/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/sign-in/:path*"
    },
    {
      "source": "/sign-up/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/sign-up/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/api/:path*"
    },
    {
      "source": "/admin-assets/:path*",
      "destination": "https://sites-by-leon-dashboard.vercel.app/admin-assets/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self' mailto: https://accounts.google.com; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://*.clerk.accounts.dev https://*.clerk.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.clerk.com https://img.clerk.com https://lh3.googleusercontent.com; connect-src 'self' https://*.supabase.co https://*.clerk.accounts.dev https://*.clerk.com; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
