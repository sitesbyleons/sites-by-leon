---
interface Props { name: string; }
const { name } = Astro.props;
---
<svg class="admin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'overview' && <><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></>}
  {name === 'users' && <><circle cx="9" cy="8" r="3" /><path d="M3.5 20c.5-4 2.3-6 5.5-6s5 2 5.5 6M16 8.5a2.5 2.5 0 1 1 0 5M16 15.5c2.7.2 4.2 1.7 4.5 4.5" /></>}
  {name === 'tickets' && <><path d="M4 5h16v12H8l-4 4z" /><path d="M8 9h8M8 13h5" /></>}
  {name === 'subscriptions' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h3" /></>}
  {name === 'sites' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01" /></>}
  {name === 'demos' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m9 9 6 3-6 3zM8 22h8M12 19v3" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
  {name === 'close' && <><path d="m6 6 12 12M18 6 6 18" /></>}
</svg>
