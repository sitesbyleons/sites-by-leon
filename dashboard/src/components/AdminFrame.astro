---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import AdminIcon from './AdminIcon.astro';
import ClerkSignOutButton from './ClerkSignOutButton.astro';
import ClerkUI from './ClerkUI.astro';

interface Props {
  active: 'overview' | 'users' | 'tickets' | 'subscriptions' | 'sites';
  title: string;
  eyebrow: string;
  description: string;
  isPreview: boolean;
  error?: string | null;
}

const { active, title, eyebrow, description, isPreview, error = null } = Astro.props;
const preview = isPreview ? '?preview=true' : '';
const links = [
  { key: 'overview', label: 'Overview', href: `/admin${preview}` },
  { key: 'users', label: 'Users', href: `/admin/users${preview}` },
  { key: 'tickets', label: 'Tickets', href: `/admin/tickets${preview}` },
  { key: 'subscriptions', label: 'Subscriptions', href: `/admin/subscriptions${preview}` },
  { key: 'sites', label: 'Sites', href: `/admin/sites${preview}` },
] as const;
---

<DashboardLayout title={title} shell>
  <div class="studio-admin">
    <aside class="studio-admin__header" data-admin-sidebar>
      <a class="admin-brand" href={`/admin${preview}`} aria-label="Sites By Leon admin">
        <span>L</span><span><strong>Leon Sites</strong><small>Business admin</small></span>
      </a>
      <button class="admin-nav-close" type="button" data-admin-nav-toggle aria-label="Close navigation"><AdminIcon name="close" /></button>
      <nav aria-label="Admin dashboard">
        <small>Manage</small>
        {links.map((link) => (
          <a href={link.href} class:list={{ 'is-active': active === link.key }} aria-current={active === link.key ? 'page' : undefined}>
            <AdminIcon name={link.key} /><span>{link.label}</span>
          </a>
        ))}
      </nav>
      {!isPreview && <div class="studio-admin__account"><ClerkUI kind="user-button" /><a href="/dashboard">Client view</a><ClerkSignOutButton>Sign out</ClerkSignOutButton></div>}
    </aside>
    <button class="admin-nav-scrim" type="button" data-admin-nav-toggle aria-label="Close navigation"></button>

    <main class="studio-admin__main">
      <header class="admin-topbar">
        <button class="admin-nav-open" type="button" data-admin-nav-toggle aria-label="Open navigation"><AdminIcon name="menu" /></button>
        <div><small>{eyebrow} / {title}</small><strong>{title}</strong></div>
        {!isPreview && <ClerkUI kind="user-button" />}
      </header>
      <div class="admin-workspace">
        <section class="admin-intro"><div><span>{eyebrow}</span><h1>{title}</h1></div><p>{description}</p></section>

        {error && <p class="simple-notice" role="status">{error}</p>}
        <slot />

        <footer class="studio-admin__footer"><span>Sites By Leon</span><small>Private business workspace</small></footer>
      </div>
    </main>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-admin-nav-toggle]').forEach((button) => {
      button.addEventListener('click', () => document.body.classList.toggle('admin-nav-visible'));
    });
  </script>
</DashboardLayout>
