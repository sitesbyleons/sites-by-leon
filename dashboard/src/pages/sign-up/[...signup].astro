---
import ClerkUI from '../../components/ClerkUI.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { normalizeReturnPath } from '../../lib/request-security';

const redirectUrl = normalizeReturnPath(Astro.url.searchParams.get('redirect_url'));
const signInUrl = `/sign-in?redirect_url=${encodeURIComponent(redirectUrl)}`;

const appearance = {
  variables: {
    colorPrimary: '#15171a',
    colorBackground: '#ffffff',
    colorText: '#15171a',
    colorTextSecondary: '#686b70',
    colorInputBackground: '#ffffff',
    colorInputText: '#15171a',
    borderRadius: '8px',
    fontFamily: 'Manrope Variable, sans-serif',
  },
  elements: {
    rootBox: 'clerk-root',
    cardBox: 'clerk-card-box',
    card: 'clerk-card',
    footer: 'clerk-footer',
  },
};
---

<DashboardLayout title="Create your account">
  <main class="auth-page auth-page--simple">
    <div class="auth-card">
      <a class="portal-brand portal-brand--small" href="/" aria-label="Sites By Leon dashboard home">
        <span>Sites</span><span>By</span><span>Leon</span>
      </a>
      <div class="auth-card__heading">
        <h1>Create account</h1>
        <p>Create an account for your Sites By Leon dashboard.</p>
      </div>
      <ClerkUI kind="sign-up" options={{ path: '/sign-up', routing: 'path', signInUrl, forceRedirectUrl: redirectUrl, appearance }} />
      <a class="auth-card__back" href={import.meta.env.PUBLIC_MARKETING_SITE_URL ?? 'https://leonsites.org'}>← Back to leonsites.org</a>
    </div>
  </main>
</DashboardLayout>
