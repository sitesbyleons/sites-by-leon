---
import { SignOutButton, UserButton } from '@clerk/astro/components';

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { checkAppAdmin } from '../../lib/admin';
import { decideDashboardAccess } from '../../lib/access';
import { canManageSubscription, canStartCheckout, plans } from '../../lib/billing';
import { createPlatformDatabase } from '../../lib/database';
import { normalizeDashboardState } from '../../lib/dashboard-state';
import { loadDashboardData } from '../../lib/load-dashboard';

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const auth = isPreview ? null : Astro.locals.auth();
const database = createPlatformDatabase();
let isAdmin = isPreview;

if (!isPreview && auth?.userId) {
  isAdmin = (await checkAppAdmin(database, auth.userId)).isAdmin;
  if (isAdmin) return Astro.redirect('/admin');
}

const access = isPreview
  ? ({ kind: 'account', userId: 'preview_user', orgId: null } as const)
  : decideDashboardAccess({ userId: auth?.userId ?? null, orgId: auth?.orgId ?? null });

if (access.kind === 'redirect') return Astro.redirect(access.location);

let dashboardData = {
  workspace: null,
  project: null,
  subscription: null,
  error: null,
} as Awaited<ReturnType<typeof loadDashboardData>>;

if (isPreview) {
  dashboardData = {
    workspace: { id: 'preview_workspace', name: 'Northline Portraits', status: 'approved' },
    project: {
      id: 'preview_project',
      name: 'Northline Portfolio',
      status: 'review',
      progress: 72,
      next_step: 'Review the mobile gallery and send Leon your final image order.',
      live_url: null,
      updated_at: new Date().toISOString(),
    },
    subscription: {
      plan_key: 'studio',
      status: 'active',
      current_period_end: '2026-08-10T00:00:00.000Z',
      cancel_at_period_end: false,
    },
    error: null,
  };
} else if (access.kind === 'account') {
  dashboardData = await loadDashboardData(database, {
    userId: access.userId,
    orgId: access.orgId,
  });
}

const state = normalizeDashboardState(dashboardData);
const hasWorkspace = Boolean(dashboardData.workspace);
const checkoutReady = canStartCheckout({
  userId: auth?.userId ?? (isPreview ? 'preview_user' : null),
  workspaceStatus: dashboardData.workspace?.status ?? null,
  subscriptionStatus: dashboardData.subscription?.status ?? null,
});
const portalReady = canManageSubscription(dashboardData.subscription?.status);
const periodEnd = dashboardData.subscription?.current_period_end
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(
      new Date(dashboardData.subscription.current_period_end),
    )
  : null;
---

<DashboardLayout title="Dashboard" shell>
  <div class="client-shell">
    <header class="client-header">
      <a class="portal-brand portal-brand--small" href="/dashboard" aria-label="Sites By Leon dashboard">
        <span>Sites</span><span>By</span><span>Leon</span>
      </a>
      <nav aria-label="Client dashboard">
        <a href="/dashboard">Website</a>
        <a href="/dashboard/support">Support</a>
        <a href="/dashboard/billing">Billing</a>
      </nav>
      <div class="client-account">
        {!isPreview && <UserButton />}
      </div>
    </header>

    <main class="client-main">
      <section class="client-intro" id="website">
        <p>Client dashboard</p>
        <h1>{hasWorkspace ? state.workspaceName : 'Sites By Leon'}</h1>
        <span>{hasWorkspace ? state.nextStep : 'Leon will add your website after setup.'}</span>
      </section>

      {dashboardData.error && <p class="simple-notice" role="status">{dashboardData.error}</p>}

      {!hasWorkspace ? (
        <section class="onboarding-card">
          <div>
            <span class="simple-label">No website connected</span>
            <h2>Contact Leon to get started.</h2>
            <p>Leon will create the project and add it to your account.</p>
          </div>
          <div class="onboarding-card__actions">
            <a class="simple-button" href="mailto:sites.by.leon@gmail.com">Contact Leon</a>
            {!isPreview && <SignOutButton><button class="simple-button simple-button--quiet" type="button">Sign out</button></SignOutButton>}
          </div>
        </section>
      ) : (
        <>
          <section class="client-status-grid" aria-label="Website summary">
            <article class="client-status-card client-status-card--primary">
              <span class="simple-label">Website status</span>
              <h2>{state.projectStatus}</h2>
              <div class="simple-progress" role="progressbar" aria-label={`${state.progress}% complete`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={state.progress}>
                <span style={`width:${state.progress}%`}></span>
              </div>
              <p>{state.progress}% complete</p>
            </article>
            <article class="client-status-card">
              <span class="simple-label">Next step</span>
              <p class="client-next-step">{state.nextStep}</p>
              {dashboardData.project?.live_url && (
                <a class="simple-link" href={dashboardData.project.live_url} target="_blank" rel="noreferrer">Open live website ↗</a>
              )}
            </article>
          </section>

          <section class="client-two-column">
            <article class="simple-panel" id="support">
              <span class="simple-label">Support ticket</span>
              <h2>Request a change</h2>
              <form data-content-request>
                <label>Subject<input name="subject" minlength="5" maxlength="120" required placeholder="What needs changing?" /></label>
                <label>Details<textarea name="details" minlength="20" maxlength="2000" required placeholder="Tell Leon what to update and where."></textarea></label>
                <div><button class="simple-button" type="submit">Send ticket</button><p data-form-status aria-live="polite"></p></div>
              </form>
            </article>

            <article class="simple-panel" id="billing">
              <span class="simple-label">Subscription</span>
              <h2>{portalReady ? state.planName : 'Choose a plan'}</h2>
              {portalReady ? (
                <>
                  <dl class="subscription-facts">
                    <div><dt>Status</dt><dd>{dashboardData.subscription?.status.replace('_', ' ')}</dd></div>
                    <div><dt>Renews</dt><dd>{periodEnd ?? 'Not available'}</dd></div>
                  </dl>
                  <form method="POST" action="/api/billing/portal">
                    <button class="simple-button simple-button--dark" type="submit">Manage subscription</button>
                  </form>
                </>
              ) : (
                <div class="simple-plan-list">
                  {plans.map((plan) => (
                    <form method="POST" action="/api/billing/checkout">
                      <input type="hidden" name="plan" value={plan.key} />
                      <span><strong>{plan.name}</strong><small>${plan.monthlyUsd}/month</small></span>
                      <button type="submit" disabled={!checkoutReady}>{checkoutReady ? 'Choose' : 'Not ready'}</button>
                    </form>
                  ))}
                </div>
              )}
              <small>Stripe processes payments.</small>
            </article>
          </section>
        </>
      )}
    </main>
  </div>

  <script>
    const requestForm = document.querySelector<HTMLFormElement>('[data-content-request]');
    const status = document.querySelector<HTMLElement>('[data-form-status]');

    requestForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.textContent = 'Sending…';
      const formData = new FormData(requestForm);
      const response = await fetch('/api/content-requests', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ subject: formData.get('subject'), details: formData.get('details') }),
      }).catch(() => null);

      if (!response?.ok) {
        const payload = await response?.json().catch(() => null);
        status.textContent = payload?.message ?? 'Ticket not sent. Email sites.by.leon@gmail.com.';
        return;
      }

      requestForm.reset();
      status.textContent = 'Ticket sent.';
    });
  </script>
</DashboardLayout>
