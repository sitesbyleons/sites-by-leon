---
import ClerkUI from '../../components/ClerkUI.astro';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { decideDashboardAccess } from '../../lib/access';
import { canManageSubscription, canStartCheckout, plans } from '../../lib/billing';
import { createPlatformDatabase } from '../../lib/database';
import { loadDashboardData } from '../../lib/load-dashboard';

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const previewSubscriptionStatus = Astro.url.searchParams.get('subscription');
const previewSubscription = previewSubscriptionStatus === 'none'
  ? null
  : { plan_key: 'studio', status: previewSubscriptionStatus ?? 'active', current_period_end: '2026-08-10T00:00:00.000Z', cancel_at_period_end: false };
const auth = isPreview ? null : Astro.locals.auth();
const access = isPreview
  ? ({ kind: 'account', userId: 'preview_user', orgId: null } as const)
  : decideDashboardAccess({ userId: auth?.userId ?? null, orgId: auth?.orgId ?? null });
if (access.kind === 'redirect') return Astro.redirect('/sign-in?redirect_url=%2Fdashboard%2Fbilling');
const data = isPreview
  ? { workspace: { id: 'preview', name: 'Northline Sports', status: 'active' }, subscription: previewSubscription, project: { plan_key: 'studio' }, error: null }
  : await loadDashboardData(createPlatformDatabase(), { userId: access.userId, orgId: access.orgId });
const selectedPlan = plans.find((plan) => plan.key === data.subscription?.plan_key);
const assignedPlan = plans.find((plan) => plan.key === data.project?.plan_key);
const manageableSubscription = data.subscription && canManageSubscription(data.subscription.status) ? data.subscription : null;
const checkoutReady = canStartCheckout({
  userId: access.userId,
  workspaceStatus: data.workspace?.status ?? null,
  subscriptionStatus: data.subscription?.status ?? null,
});
---

<DashboardLayout title="Billing" shell>
  <div class="client-shell">
    <header class="client-header">
      <a class="portal-brand portal-brand--small" href="/dashboard" aria-label="Sites By Leon dashboard"><span>Sites</span><span>By</span><span>Leon</span></a>
      <nav aria-label="Client dashboard"><a href="/dashboard">Website</a><a href="/dashboard/support">Support</a><a href="/dashboard/billing" aria-current="page">Billing</a></nav>
      <div class="client-account">{!isPreview && <ClerkUI kind="user-button" />}</div>
    </header>
    <main class="client-main client-main--page">
      <section class="client-intro"><p>Client dashboard</p><h1>Billing</h1><span>View your plan and manage billing with Stripe.</span></section>
      <article class="simple-panel client-page-panel">
        {data.error && <p class="simple-notice" role="status">{data.error}</p>}
        {manageableSubscription ? (
          <>
            <span class="simple-label">Current plan</span>
            <h2>{selectedPlan?.name ?? 'Hosting'}</h2>
            <dl class="subscription-facts">
              <div><dt>Status</dt><dd>{manageableSubscription.status.replace('_', ' ')}</dd></div>
              <div><dt>Price</dt><dd>{selectedPlan ? `$${selectedPlan.monthlyUsd}/month` : 'Contact Leon'}</dd></div>
            </dl>
            <form method="POST" action="/api/billing/portal"><button class="simple-button simple-button--dark" type="submit" disabled={isPreview}>Manage subscription</button></form>
          </>
        ) : (
          <>
            <span class="simple-label">Assigned hosting plan</span>
            <h2>{assignedPlan?.name ?? 'Plan pending'}</h2>
            <div class="simple-plan-list">
              {assignedPlan ? <form method="POST" action="/api/billing/checkout" data-checkout-form><input type="hidden" name="plan" value={assignedPlan.key} /><span><strong>{assignedPlan.name}</strong><small>${assignedPlan.monthlyUsd}/month</small></span><button type="submit" disabled={!checkoutReady}>{checkoutReady ? `Pay $${assignedPlan.monthlyUsd}/month` : 'Not ready'}</button></form> : <p class="simple-notice">Leon is finishing your hosting setup.</p>}
            </div>
            <p class="checkout-status" data-checkout-status aria-live="polite"></p>
          </>
        )}
      </article>
    </main>
  </div>
  <script is:inline src="/admin-assets/checkout.js"></script>
</DashboardLayout>
