---
import AdminFrame from '../../components/AdminFrame.astro';
import {checkAppAdmin} from '../../lib/admin';
import {decideAdminAccess} from '../../lib/access';
import {createPlatformDatabase} from '../../lib/database';
import {loadOperations,snapshotWarnings} from '../../lib/operations';
const isPreview=import.meta.env.DEV&&Astro.url.searchParams.get('preview')==='true';
const auth=isPreview?null:Astro.locals.auth();
const database=createPlatformDatabase();
const admin=isPreview?{isAdmin:true}:await checkAppAdmin(database,auth?.userId??'');
const access=decideAdminAccess({userId:isPreview?'preview':auth?.userId??null,isAdmin:admin.isAdmin});
if(access.kind!=='admin')return Astro.redirect(access.location);
Astro.response.headers.set('Cache-Control','private, no-store');
const {servers,errors}=await loadOperations();
type Connection={workspace_id:string;site_key:string;primary_domain:string;status:string;deployment_target:string|null;github_repository:string|null};
const connectionResult=isPreview?null:await database?.from('site_connections').select<Connection>('workspace_id,site_key,primary_domain,status,deployment_target,github_repository').order('site_key',{ascending:true}).limit(100);
const connections=connectionResult?.data??[];
if(connectionResult?.error)errors.push('Site assignments could not be loaded.');
const gib=(n:number)=>(n/1073741824).toFixed(1)+' GiB';
const date=(s:string|number)=>new Date(s).toLocaleString('en-US',{timeZone:'UTC'})+' UTC';
const repoHref=(value:string|null)=>{if(!value)return null;const raw=value.replace(/^https:\/\/github\.com\//,'').replace(/\.git$/,'');return /^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(raw)?'https://github.com/'+raw:null;};
---
<AdminFrame active="operations" title="Operations" eyebrow="Platform" description="Server capacity, service health and recovery readiness." isPreview={isPreview}>
 <div class="ops">
  <header class="ops-toolbar"><p>Read-only infrastructure view. Snapshots update every minute; refresh to see the latest.</p><a href={isPreview?'?preview=true':'/admin/operations'}>Refresh status</a></header>
  {errors.map(error=><p class="ops-warning" role="status">{error}</p>)}
  {!servers.length&&<section class="ops-panel"><h2>No server telemetry connected</h2><p>There is no verified server snapshot to show. This is not a healthy or zero-usage reading.</p></section>}
  {servers.map(server=>{const warnings=snapshotWarnings(server);const memoryUsed=100*(1-server.memoryAvailableBytes/server.memoryTotalBytes);const diskUsed=100*(1-server.diskFreeBytes/server.diskTotalBytes);return <section class="ops-server">
   <header class="ops-server-title"><div><h2>{server.label}</h2><p>{server.hostname} · {server.cpuCores} vCPUs · {gib(server.memoryTotalBytes)} RAM</p></div><div><strong class:list={{'ops-attention':warnings.length>0}}>{warnings.length?'Needs attention':'Checks within thresholds'}</strong><p>Snapshot: {date(server.collectedAt)}</p></div></header>
   {warnings.length>0&&<ul class="ops-warnings">{warnings.map(warning=><li>{warning}</li>)}</ul>}
   <div class="ops-resources">
    <article><h3>Memory</h3><strong>{gib(server.memoryAvailableBytes)} available</strong><meter min="0" max="100" value={memoryUsed} aria-label={`${memoryUsed.toFixed(1)} percent memory used`}/><p>{gib(server.memoryTotalBytes)} total · {(memoryUsed).toFixed(1)}% used</p></article>
    <article><h3>Disk</h3><strong>{gib(server.diskFreeBytes)} free</strong><meter min="0" max="100" value={diskUsed} aria-label={`${diskUsed.toFixed(1)} percent disk used`}/><p>{gib(server.diskTotalBytes)} total · {diskUsed.toFixed(1)}% used</p></article>
    <article><h3>CPU load</h3><strong>{server.loadAverage[0].toFixed(2)} / {server.cpuCores} cores</strong><p>1 / 5 / 15 minutes: {server.loadAverage.map(n=>n.toFixed(2)).join(' / ')}</p><p>Load average is queued/running work, not CPU percentage.</p></article>
    <article><h3>Uptime</h3><strong>{Math.floor(server.uptimeSeconds/86400)} days</strong><p>Host uptime, not a website availability guarantee.</p><p>{server.services.length} production / legacy services observed</p></article>
   </div>
   {server.storage&&<section class="ops-panel"><h3>Upload capacity and reservations</h3><p>{gib(server.storage.usedBytes)} actually stored · {gib(server.storage.reservedBytes)} allocated across {server.storage.workspaces} workspaces · {server.storage.provisionableBytes===null?'Unknown configured budget':gib(server.storage.provisionableBytes)+' configured provisioning budget'}.</p><p>Reservations are promised allowances, not disk usage. Provisioning blocks new sites when their allowance does not fit this budget. Increasing a setting does not increase the disk.</p></section>}
   <div class="ops-recovery">
    <article><h3>Encrypted backup</h3><strong>{server.backup.result==='success'?'Last job succeeded':server.backup.result}</strong><p>{server.backupLastSuccess?date(server.backupLastSuccess*1000):'No successful backup marker'}</p><p>Daily schedule. A successful backup is not proof of a successful restore.</p></article>
    <article><h3>Production monitor</h3><strong>{server.monitor.result==='success'?'Last check passed':server.monitor.result}</strong><p>{server.monitor.lastFinished||'No completion timestamp'}</p><p>Health, backup age and disk threshold checks.</p></article>
    <article><h3>Analytics retention</h3><strong>{server.retention.result==='success'?'Last cleanup succeeded':server.retention.result}</strong><p>{server.retention.lastFinished||'No completion timestamp'}</p><p>Optional visitor records expire after 90 days.</p></article>
   </div>
   <section class="ops-panel"><h3>Services and deployments</h3><p>Current container state. “Not configured” means no container health check exists, not that the service is verified healthy.</p><div class="ops-scroll" tabindex="0" role="region" aria-label="Scrollable operations table"><table><thead><tr><th scope="col">Service</th><th scope="col">State / health</th><th scope="col">Memory limit</th><th scope="col">Restarts</th><th scope="col">Image</th></tr></thead><tbody>{server.services.map(service=><tr><th scope="row">{service.name}</th><td>{service.state}<small>{service.health}</small></td><td>{service.memoryLimitBytes?gib(service.memoryLimitBytes):'No limit'}</td><td>{service.restarts}</td><td class="ops-image">{service.image}</td></tr>)}</tbody></table></div></section>
  </section>;})}
  <section class="ops-panel"><h2>Site assignments</h2><p>First 100 configured sites. The deployment target is configuration, not an independent uptime check.</p><div class="ops-scroll" tabindex="0" role="region" aria-label="Scrollable operations table"><table><thead><tr><th scope="col">Site</th><th scope="col">Status</th><th scope="col">Deployment target</th><th scope="col">Repository</th></tr></thead><tbody>{connections.map(site=><tr><th scope="row">{site.primary_domain}<small>{site.site_key}</small></th><td>{site.status}</td><td>{site.deployment_target??'Unassigned'}</td><td>{repoHref(site.github_repository)?<a href={repoHref(site.github_repository)!} target="_blank" rel="noreferrer">View repository</a>:'Not linked'}</td></tr>)}</tbody></table></div>{!connections.length&&<p>No site assignments loaded.</p>}</section>
  <section class="ops-planning"><div><h2>Before the next client</h2><p>Your current goal is 6–8 client websites. Use measured CPU and RAM demand to plan capacity; upload storage and recovery procedures need their own budget.</p><ul><li>Reserve OS, database, logs and deployment space before allocating uploads.</li><li>Eight fully used 15 GiB allowances require 120 GiB, before backups. Local backup staging needs additional space.</li><li>Use external object storage or expand disk before those allowances can be filled. Do not promise capacity based on today’s low usage.</li><li>Run a restore drill and verify alert delivery before promising a recovery time.</li></ul></div><div><h2>Growing beyond one VPS</h2><p>Add another snapshot to this read-only view when another server exists. This page does not buy, provision, restart or migrate servers.</p><p>Move uploads out of the app host, keep deployments reproducible, then split workloads when measured traffic justifies it. A second server alone does not create high availability.</p></div></section>
 </div>
</AdminFrame>
<style>
 .ops{display:grid;gap:24px;min-width:0}.ops p{font-size:13px;line-height:1.65;color:#58665d}.ops h2{font-size:23px;letter-spacing:-.025em;margin:0 0 8px}.ops h3{font-size:16px;margin:0 0 14px}.ops a{color:#254b37;text-underline-offset:3px}.ops-toolbar,.ops-server-title{display:flex;justify-content:space-between;align-items:center;gap:24px}.ops-toolbar p{margin:0}.ops-toolbar>a{white-space:nowrap;padding:12px 18px;border:1px solid #b8c6b8;border-radius:6px;font-size:13px}.ops-server{display:grid;gap:20px}.ops-server-title>div:last-child{text-align:right;font-size:13px}.ops-server-title p{margin:4px 0}.ops-attention{color:#8a5118}.ops-warning,.ops-warnings{background:#fff7e8;color:#714418!important;border-radius:6px;padding:16px 20px}.ops-warnings{padding-left:36px;margin:0;font-size:13px;line-height:1.9}.ops-resources{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ops-resources article{padding:24px;background:#f1f4ef;border-radius:8px;min-width:0}.ops-resources strong{font-size:23px;line-height:1.3;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.ops meter{display:block;width:100%;height:9px;margin:20px 0 8px}.ops meter::-webkit-meter-bar{background:#dce4d9;border:0}.ops meter::-webkit-meter-optimum-value{background:#477866}.ops-recovery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;padding:16px 0}.ops-recovery article{padding-right:12px}.ops-recovery strong{font-size:16px}.ops-panel{border:1px solid #e1e7df;border-radius:8px;padding:24px;min-width:0}.ops-scroll{overflow:auto;margin-top:18px}.ops table{width:100%;border-collapse:collapse;font-size:12px;text-align:left}.ops th,.ops td{padding:14px 12px;border-bottom:1px solid #e4e9e1;vertical-align:top}.ops th:first-child{padding-left:0}.ops small{display:block;font-weight:400;color:#58665d;margin-top:5px}.ops-image{max-width:260px;overflow-wrap:anywhere}.ops-planning{display:grid;grid-template-columns:1.5fr 1fr;gap:40px;padding:20px 0}.ops-planning ul{font-size:13px;line-height:1.9;color:#58665d;padding-left:18px}.ops :focus-visible{outline:3px solid #997624;outline-offset:3px}@media(max-width:1100px){.ops-resources{grid-template-columns:repeat(2,minmax(0,1fr))}.ops-recovery{grid-template-columns:1fr}.ops-planning{grid-template-columns:1fr;gap:20px}}@media(max-width:600px){.ops-toolbar,.ops-server-title{align-items:start;flex-direction:column;gap:12px}.ops-server-title>div:last-child{text-align:left}.ops-resources{grid-template-columns:1fr}.ops-panel{padding:18px}.ops-resources article{padding:20px}.ops table{min-width:640px}}
</style>
