---
import { clerkClient } from '@clerk/astro/server';

import AdminFrame from '../../components/AdminFrame.astro';
import { decideAdminAccess } from '../../lib/access';
import { loadAdminSession } from '../../lib/admin';

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const auth = isPreview ? null : Astro.locals.auth();
const session = await loadAdminSession({
  isPreview,
  userId: isPreview ? 'preview_admin' : (auth?.userId ?? null),
  getToken: async () => (auth ? (await auth.getToken()) ?? null : null),
  includeUsers: true,
  userClient: isPreview ? undefined : clerkClient(Astro),
});
const access = decideAdminAccess({
  userId: isPreview ? 'preview_admin' : (auth?.userId ?? null),
  isAdmin: session.isAdmin,
});
if (access.kind !== 'admin') return Astro.redirect(access.location);

const data = session.data!;
const workspaceNames = new Map(data.workspaces.map((workspace) => [workspace.id, workspace.name]));
const connections = new Map(data.connections.map((connection) => [connection.workspace_id, connection]));
const openTickets = data.requests.filter((request) => !['completed', 'declined'].includes(request.status));
const activeSubscriptions = data.subscriptions.filter((subscription) => ['active', 'trialing'].includes(subscription.status));
const recentTickets = openTickets.slice(0, 4);
const clientProjects = data.projects.filter((project) => connections.get(project.workspace_id)?.site_kind !== 'demo');
const recentSites = clientProjects.slice(0, 3);
const preview = isPreview ? '?preview=true' : '';
const date = (value: string | number | null) => value
  ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' }).format(new Date(value))
  : '—';
---

<AdminFrame
  active="overview"
  title="Overview"
  eyebrow="Sites By Leon"
  description="Accounts, support, billing, and sites."
  isPreview={isPreview}
  error={session.error}
>
  <section class="admin-summary admin-summary--four" aria-label="Business summary">
    <a href={`/admin/users${preview}`}><span>Users</span><strong>{session.users.length}</strong><small>View accounts</small></a>
    <a href={`/admin/tickets${preview}`}><span>Open tickets</span><strong>{openTickets.length}</strong><small>Sort support</small></a>
    <a href={`/admin/subscriptions${preview}`}><span>Active subscriptions</span><strong>{activeSubscriptions.length}</strong><small>Review billing</small></a>
    <a href={`/admin/sites${preview}`}><span>Sites</span><strong>{clientProjects.length}</strong><small>Track builds</small></a>
  </section>

  <div class="admin-overview-grid">
    <section class="admin-list-section">
      <header><div><span>Needs attention</span><h2>Open tickets</h2></div><a href={`/admin/tickets${preview}`}>View all</a></header>
      <div class="ticket-list">
        {recentTickets.length ? recentTickets.map((ticket) => (
          <article>
            <span class={`ticket-status ticket-status--${ticket.status}`}>{ticket.status.replace('_', ' ')}</span>
            <div><strong>{ticket.subject}</strong><small>{workspaceNames.get(ticket.workspace_id) ?? 'Client'} · {date(ticket.created_at)}</small></div>
          </article>
        )) : <p class="simple-empty">No open support tickets.</p>}
      </div>
    </section>

    <section class="admin-list-section">
      <header><div><span>In production</span><h2>Sites</h2></div><a href={`/admin/sites${preview}`}>View all</a></header>
      <div class="site-list site-list--compact">
        {recentSites.length ? recentSites.map((project) => (
          <article>
            <div><strong>{project.name}</strong><small>{workspaceNames.get(project.workspace_id) ?? 'Client'}</small></div>
            <div class="site-progress" role="progressbar" aria-label={`${project.progress}% complete`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={project.progress}><span style={`width:${project.progress}%`}></span></div>
            <span>{project.status} · {project.progress}%</span>
          </article>
        )) : <p class="simple-empty">No sites yet.</p>}
      </div>
    </section>
  </div>
</AdminFrame>
