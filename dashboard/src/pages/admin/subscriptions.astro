---
import AdminFrame from '../../components/AdminFrame.astro';
import { decideAdminAccess } from '../../lib/access';
import { isPortfolioDemo, loadAdminSession } from '../../lib/admin';
import { listClientHostingRows } from '../../lib/billing';

const isPreview = import.meta.env.DEV && Astro.url.searchParams.get('preview') === 'true';
const auth = isPreview ? null : Astro.locals.auth();
const session = await loadAdminSession({ isPreview, userId: isPreview ? 'preview_admin' : (auth?.userId ?? null), getToken: async () => (auth ? (await auth.getToken()) ?? null : null) });
const access = decideAdminAccess({ userId: isPreview ? 'preview_admin' : (auth?.userId ?? null), isAdmin: session.isAdmin });
if (access.kind !== 'admin') return Astro.redirect(access.location);

const data = session.data!;
const preview = isPreview ? '?preview=true' : '';
const status = Astro.url.searchParams.get('status') ?? 'all';
const sort = Astro.url.searchParams.get('sort') ?? 'client';
const includeWorkspaceIds = new Set<string>();
for (const workspace of data.workspaces) {
  const connection = data.connections.find((item) => item.workspace_id === workspace.id);
  if (!isPortfolioDemo(connection, workspace)) includeWorkspaceIds.add(workspace.id);
}
for (const subscription of data.subscriptions) includeWorkspaceIds.add(subscription.workspace_id);

const rows = listClientHostingRows({
  workspaces: data.workspaces,
  projects: data.projects,
  subscriptions: data.subscriptions,
  checkoutAttempts: data.checkoutAttempts,
  includeWorkspaceIds,
})
  .filter((row) => status === 'all' || row.statusKey === status)
  .sort((a, b) => {
    if (sort === 'renewal') return Date.parse(a.nextAt ?? '9999-12-31') - Date.parse(b.nextAt ?? '9999-12-31');
    if (sort === 'status') return a.statusKey.localeCompare(b.statusKey);
    return a.clientName.localeCompare(b.clientName);
  });
const date = (value: string | null) => value ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(value)) : '—';
---

<AdminFrame active="subscriptions" title="Subscriptions" eyebrow="Stripe billing" description="See every hosting plan, payment state, and renewal date." isPreview={isPreview} error={session.error}>
  <form class="admin-tools" method="get" aria-label="Sort and filter subscriptions">
    {isPreview && <input type="hidden" name="preview" value="true" />}
    <label><span>Status</span><select name="status"><option value="all" selected={status === 'all'}>All statuses</option><option value="active" selected={status === 'active'}>Active</option><option value="trialing" selected={status === 'trialing'}>Trialing</option><option value="invoice_open" selected={status === 'invoice_open'}>Invoice open</option><option value="not_billed" selected={status === 'not_billed'}>Not billed</option><option value="past_due" selected={status === 'past_due'}>Past due</option><option value="canceled" selected={status === 'canceled'}>Canceled</option></select></label>
    <label><span>Sort</span><select name="sort"><option value="client" selected={sort === 'client'}>Client A–Z</option><option value="renewal" selected={sort === 'renewal'}>Renewing soon</option><option value="status" selected={sort === 'status'}>Status A–Z</option></select></label>
    <button type="submit">Apply</button>
  </form>

  <section class="admin-list-section admin-list-section--results">
    <header><div><span>Monthly hosting</span><h2>Plans</h2></div><p>{rows.length} shown</p></header>
    <div class="business-table business-table--subscriptions" role="table" aria-label="Client subscriptions">
      <div class="business-table__head" role="row"><span role="columnheader">Client</span><span role="columnheader">Plan</span><span role="columnheader">Status</span><span role="columnheader">Next</span></div>
      {rows.length ? rows.map((row) => (
          <article class="business-table__row" role="row">
            <div role="cell"><strong><a href={`/admin/sites/${row.workspaceId}${preview}`}>{row.clientName}</a></strong><small>Managed hosting</small></div>
            <span role="cell">{row.amountLabel}</span>
            <span role="cell" class={`ticket-status ticket-status--${row.statusKey}`}>{row.statusLabel}</span>
            <span role="cell">{date(row.nextAt)}</span>
          </article>
        )) : <p class="simple-empty">No subscriptions match that status.</p>}
    </div>
  </section>
</AdminFrame>
