{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	request_body {
		max_size 16MB
	}

	header {
		-Server
		+Content-Security-Policy "base-uri 'self'; form-action 'self' mailto: https://accounts.google.com; frame-ancestors 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Resource-Policy same-site
		X-Permitted-Cross-Domain-Policies none
	}

	@private path /admin /admin/* /dashboard /dashboard/* /sign-in /sign-in/* /sign-up /sign-up/* /api/*
	header @private Cache-Control "private, no-store"

	handle /healthz {
		respond 200
	}

	@dashboard {
		host {$MARKETING_DOMAIN} {$MARKETING_WWW_DOMAIN}
		path /admin /admin/* /dashboard /dashboard/* /sign-in /sign-in/* /sign-up /sign-up/* /api/* /admin-assets/*
	}
	handle @dashboard {
		reverse_proxy dashboard:4321
	}

	@coming_soon {
		host {$MARKETING_DOMAIN} {$MARKETING_WWW_DOMAIN}
		path / /index.html
		expression {env.PUBLIC_SITE_MODE} == "coming-soon"
	}
	handle @coming_soon {
		root * /srv/marketing
		rewrite * /coming-soon/index.html
		file_server
	}

	@test host {$TEST_DOMAIN}
	handle @test {
		reverse_proxy gateway-test:80
	}

	@marketing host {$MARKETING_DOMAIN} {$MARKETING_WWW_DOMAIN}
	handle @marketing {
		root * /srv/marketing
		try_files {path} {path}/index.html /404.html
		file_server
	}

	@media host {$MEDIA_DOMAIN}
	handle @media {
		header Cross-Origin-Resource-Policy cross-origin
		handle_path /media/* {
			root * /srv/uploads
			header Cache-Control "public, max-age=300, must-revalidate"
			file_server
		}
		handle {
			respond "Not found" 404
		}
	}

	# Cloudflare publishes the allowed customer hostnames. The shared photographer
	# runtime performs a second exact-host database lookup and rejects unknown hosts.
	handle {
		reverse_proxy photographer:4321
	}
}
