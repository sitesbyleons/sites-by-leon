# Public hostnames routed through Cloudflare Tunnel.
MARKETING_DOMAIN=leonsites.org
MARKETING_WWW_DOMAIN=www.leonsites.org
DASHBOARD_DOMAIN=app.leonsites.org
TEST_DOMAIN=test.leonsites.org
DEMO_DOMAIN=demo.leonsites.org
MEDIA_DOMAIN=api.leonsites.org
UPLOADS_PATH=/opt/leon-platform/uploads

# Public browser configuration. These are safe to place in built client assets.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Create this file locally with chmod 600; do not commit it.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
