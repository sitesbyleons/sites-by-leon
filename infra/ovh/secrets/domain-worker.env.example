# Restricted PostgreSQL login used only by the custom-domain worker. Generate the
# URL-safe password with `openssl rand -hex 32` and put the exact same value in
# POSTGRES_DOMAIN_WORKER_PASSWORD inside postgres.env.
DATABASE_URL=postgresql://leon_domain_worker:replace_with_64_hex_characters@database:5432/leon_platform

# Cloudflare for SaaS zone credentials. Enable Cloudflare for SaaS on the zone first,
# then scope a zone token for leonsites.org to SSL and Certificates: Edit.
CLOUDFLARE_API_TOKEN=replace_with_scoped_cloudflare_token
CLOUDFLARE_ZONE_ID=replace_with_leonsites_zone_id
CLOUDFLARE_EXPECTED_FALLBACK_ORIGIN=customers.leonsites.org

DOMAIN_WORKER_POLL_INTERVAL_MS=10000
DOMAIN_WORKER_RECONCILE_INTERVAL_MS=300000
DOMAIN_WORKER_MAX_ATTEMPTS=10
DATABASE_POOL_MAX=1
