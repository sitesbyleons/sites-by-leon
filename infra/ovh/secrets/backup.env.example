RESTIC_REPOSITORY=rclone:supabase:leon-sites-backups/restic
RESTIC_PASSWORD_FILE=/opt/leon-platform/backup-secrets/restic-password
ALLOW_LOCAL_BACKUP=false
AWS_ACCESS_KEY_ID=replace_with_supabase_project_ref
AWS_SECRET_ACCESS_KEY=replace_with_supabase_legacy_anon_key
AWS_DEFAULT_REGION=replace_with_project_region
SUPABASE_BACKUP_AUTH_URL=https://replace_with_project_ref.supabase.co/auth/v1/token?grant_type=password
SUPABASE_BACKUP_EMAIL=restic-backup@leonsites.org
SUPABASE_BACKUP_PASSWORD=replace_me
SUPABASE_BACKUP_COMMAND_TIMEOUT_SECONDS=3000
RCLONE_CONFIG_SUPABASE_TYPE=s3
RCLONE_CONFIG_SUPABASE_PROVIDER=Other
RCLONE_CONFIG_SUPABASE_ENV_AUTH=true
RCLONE_CONFIG_SUPABASE_ENDPOINT=https://replace_with_project_ref.storage.supabase.co/storage/v1/s3
RCLONE_CONFIG_SUPABASE_REGION=replace_with_project_region
RCLONE_CONFIG_SUPABASE_FORCE_PATH_STYLE=true
BACKUP_STAGING_ROOT=/opt/leon-platform-backup-staging/staging-current
RESTORE_DRILL_ROOT=/opt/leon-platform/restore-drills
BACKUP_MIN_FREE_BYTES=10737418240
BACKUP_HEALTHCHECK_SCRIPT=/usr/local/libexec/leon-platform/healthcheck.sh
BACKUP_HEALTHCHECK_ATTEMPTS=12
BACKUP_HEALTHCHECK_INTERVAL_SECONDS=5
