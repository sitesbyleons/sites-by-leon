FROM node:24-bookworm-slim AS marketing-build
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY dashboard/package.json dashboard/package.json
COPY domain-worker/package.json domain-worker/package.json
COPY platform-core/package.json platform-core/package.json
COPY photographer-site/package.json photographer-site/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter sites-by-leon build

FROM caddy:2.11.4-alpine
COPY infra/ovh/Caddyfile /etc/caddy/Caddyfile
COPY --from=marketing-build /workspace/dist /srv/marketing
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/healthz || exit 1
