{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip
	request_body {
		max_size 16MB
	}

	header {
		-Server
		+Content-Security-Policy "base-uri 'self'; form-action 'self' mailto: https://accounts.google.com; frame-ancestors 'none'; object-src 'none'"
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@same_site_resources not path /media/*
	header @same_site_resources Cross-Origin-Resource-Policy same-site

	@private path /admin /admin/* /dashboard /dashboard/* /sign-in /sign-in/* /sign-up /sign-up/* /api/*
	header @private Cache-Control "private, no-store"

	handle /healthz {
		respond 200
	}

	@dashboard {
		host {$TEST_DOMAIN}
		path /admin /admin/* /dashboard /dashboard/* /sign-in /sign-in/* /sign-up /sign-up/* /api/* /admin-assets/*
	}
	handle @dashboard {
		reverse_proxy dashboard-test:4321
	}

	@media {
		host {$TEST_DOMAIN}
		path /media/*
	}
	handle @media {
		handle_path /media/* {
			rewrite * /api/media{path}
			reverse_proxy photographer-test:4321
		}
	}

	@marketing host {$TEST_DOMAIN}
	handle @marketing {
		root * /srv/marketing
		try_files {path} {path}/index.html /404.html
		file_server
	}

	@ishotyouu_admin {
		host ishotyouu-test.leonsites.org
		path /admin /admin/* /sign-in /sign-in/* /sign-up /sign-up/* /api/*
	}
	handle @ishotyouu_admin {
		reverse_proxy photographer-test:4321
	}

	@ishotyouu_public host ishotyouu-test.leonsites.org
	handle @ishotyouu_public {
		reverse_proxy ishotyouu-demo-test:80
	}

	@test_customer header_regexp test_customer Host ^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?-test\.leonsites\.org(?::[0-9]+)?$
	handle @test_customer {
		reverse_proxy photographer-test:4321
	}

	handle {
		respond "Not found" 404
	}
}
